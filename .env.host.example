# ============================================================================
# RAG —— **宿主机运行（java -jar）** 环境变量样例
# ============================================================================
#
# 用法：
#   cp .env.host.example .env.host
#   set -a && . ./.env.host && set +a
#   java -jar service/<域>/<域>-api/target/<域>-api-0.0.1-SNAPSHOT.jar
#
# ⚠️ **为什么有两份模板**（`.env.example` = 容器内语义 / 本文件 = 宿主机语义）：
#   · `.env.example` 里的地址是**容器内 DNS 名**（`postgres` / `redis` / `nacos` /
#     `kafka` / `minio` / `jaeger`）+ **容器内端口** ⇒ 那是 **compose 内部**能解析的值
#     ⇒ **宿主机直接起 jar 时这些名字解析不了** ⇒ 必须用本文件的 `127.0.0.1` + 宿主映射端口。
#   · 两份模板的**变量名完全一致** ⇒ 切换部署形态只需换一份 env 文件，**代码零改动**。
#   · ⛔ **compose 读的是 `.env`，不是本文件** ⇒ 改本文件**不会**影响 compose。
#
# 🔴 **「必填」= 缺了就起不来**，这是设计意图，不是麻烦：
#   密钥类变量缺值 ⇒ Spring **绑定期直接炸**（不存在「悄悄用空密钥起来」这条路径 · P0 #8）。
#
# ⚠️ **Kafka / MinIO / etcd 不在本仓的 compose 里**（本仓 compose 只编排 7 个：
#   postgres · redis · nacos · jaeger · prometheus · user-rpc · user-api）⇒
#   下面写的 Kafka / MinIO 宿主端口**取自兄弟仓 `sea-ridethewind_java` 的同名容器**
#   ⇒ 本机没有这些容器时要自己起（口径见 README §三）。
# ============================================================================


# ============================================================================
# 1. 必填 · 密钥（**无默认值 ⇒ 缺了就起不来**）
# ============================================================================

# 🔴 用户域 JWT 签名密钥 —— user-api / user-rpc 是签发方；
#    article-api / comment-api / follow-api / like-api / message-api / favorite-api 只验签
#    ⇒ 验签密钥必须与签发方**完全一致**，否则表现为 **HTTP 401 + 空 body**。
# · **≥ 32 字节**（jjwt 的 HMAC-SHA256 下限）
# · 建议：`openssl rand -hex 32`
USER_JWT_SECRET=<openssl rand -hex 32>

# 🔴 管理域 JWT 签名密钥 —— admin-api / admin-rpc 专用，与用户域**分开**。
ADMIN_JWT_SECRET=<openssl rand -hex 16>

# 🔴 favorite 域的验签密钥 —— favorite-api 用（签发方仍是 user-api）。
#    ⚠️ 空串 ⇒ favorite-api **启动失败**。
FAVORITE_JWT_SECRET=<与 USER_JWT_SECRET 相同的值>

# 🔴 Postgres 密码 —— 与 `.env` 的同名变量**保持一致**（compose 起的 PG 用的就是它）。
POSTGRES_PASSWORD=<自定，勿用默认>


# ============================================================================
# 2. 建议覆盖 · 部署凭据（**有默认值，但仓里是公开的 ⇒ 生产必须覆盖**）
# ============================================================================

# 🔴 MinIO（对象存储）访问凭据 —— article-rpc 用。
MINIO_ACCESS_KEY=<自定>
MINIO_SECRET_KEY=<自定>

# 🔴 事实权威端（fact-authority）内部调用令牌 —— like-rpc / comment-rpc / favorite-rpc 用。
LIKE_FACT_AUTHORITY_TOKEN=<自定>
COMMENT_FACT_AUTHORITY_TOKEN=<自定>
FAVORITE_AUTHORITY_TOKEN=<自定>

# 🔴 外部平台（DC platform）事件回调的共享令牌 —— like-rpc / comment-rpc / favorite-rpc 用。
DC_PLATFORM_SERVICE_TOKEN=<自定>
DC_PLATFORM_EVENT_URL=<事件回调地址，默认空 = 不启用>

# 🔴 admin 初始账号密码 —— admin-rpc 建管理员时用。默认 `123456` ⇒ 生产必须覆盖。
ADMIN_DEFAULT_PASSWORD=<自定，勿用 123456>

# Redis 密码 —— 默认空 = 无认证（本地开发友好）。生产建议开。
REDIS_PASSWORD=

# Nacos 账号密码 —— 默认空 = standalone 无认证。生产建议开。
NACOS_USERNAME=
NACOS_PASSWORD=


# ============================================================================
# 3. 基础设施连接（**宿主机语义**：全部 127.0.0.1 + 宿主映射端口）
# ============================================================================

# ---- Postgres（compose 映射 49432 → 容器 5432）----
# ⚠️ POSTGRES_USER / POSTGRES_DB **必须与 `.env` 里的同名变量一致**
#    （compose 的 PG 容器按 `.env` 建库；不一致 ⇒ 宿主机 jar 连不上 / 找不到 schema）
POSTGRES_USER=admin
POSTGRES_DB=first_db
POSTGRES_HOST=127.0.0.1
POSTGRES_ADDR=127.0.0.1
POSTGRES_PORT=49432
POSTGRES_SSLMODE=disable

# ---- Redis（compose 映射 49380 → 容器 6379）----
REDIS_ADDR=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PORT=49380

# ---- Nacos（compose 映射 49848 → 容器 8848）----
# ⚠️ namespace / group 必须**所有服务一致**，否则 `discovery://` 解析不到
#    （users 域的 yml 默认值是 sea-rtw/USER_GROUP，其余 9 域是 public/DEFAULT_GROUP
#      ⇒ 宿主机跑 20 个服务时**必须统一成 public/DEFAULT_GROUP**）
NACOS_ADDR=127.0.0.1
NACOS_PORT=49848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP

# ---- Kafka（兄弟仓容器：宿主 49992 → EXTERNAL 9093；已 advertise 127.0.0.1:49992）----
KAFKA_BROKERS=127.0.0.1:49992

# ---- MinIO（兄弟仓容器：宿主 49100 → 容器 9000）----
MINIO_ENDPOINT=127.0.0.1:49100
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:49100

# ---- OpenTelemetry / Jaeger（compose 映射 49317 → 容器 4317 · 49318 → 4318）----
# ⚠️ trace 导出**失败不阻断启动**（服务照常起）⇒ 这两项不影响「在服务」三判据。
# ⚠️ **api 与 rpc 读的是两个不同的变量**（别混）：
#   · api 侧  = `http://${OTEL_ADDR}:${OTLP_PORT}` ⇒ 走 Jaeger 的 **OTLP/HTTP** 接收口（容器 4318）
#   · rpc 侧  = `${OTEL_EXPORTER_OTLP_ENDPOINT}` ⇒ 走 Jaeger 的 **OTLP/gRPC** 接收口（容器 4317）
OTEL_ADDR=127.0.0.1
OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:49317
OTLP_PORT=49318


# ============================================================================
# 4. 端口（**20 个服务两两不同**；口径见 docs/RoundPlan/round-01/service-startup-matrix.md）
# ============================================================================

# ---- api（HTTP 业务口）----
USER_API_PORT=49900
ADMIN_API_PORT=8890
ARTICLE_API_PORT=8889
COMMENT_API_PORT=8888
FAVORITE_API_PORT=18893
FOLLOW_API_PORT=8891
HOT_API_PORT=18897
LIKE_API_PORT=18887
MESSAGE_API_PORT=8892
TASK_API_PORT=18886

# ---- rpc（gRPC 口）----
USER_RPC_PORT=49210
ADMIN_RPC_PORT=8081
ARTICLE_RPC_PORT=9001
COMMENT_RPC_PORT=9002
FAVORITE_RPC_PORT=8082
FOLLOW_RPC_PORT=8083
HOT_RPC_GRPC_PORT=8084
LIKE_RPC_PORT=8085
MESSAGE_RPC_PORT=8086
TASK_RPC_PORT=9005

# ---- rpc 的 actuator 口（`server.port`）----
USER_RPC_MANAGEMENT_PORT=9094
ADMIN_RPC_MANAGEMENT_PORT=9097
ARTICLE_RPC_MANAGEMENT_PORT=9092
FAVORITE_RPC_MANAGEMENT_PORT=16062
FOLLOW_RPC_MANAGEMENT_PORT=16065
HOT_RPC_MANAGEMENT_PORT=19091
LIKE_RPC_MANAGEMENT_PORT=9098
MESSAGE_RPC_MANAGEMENT_PORT=16067
TASK_RPC_MANAGEMENT_PORT=8080
# ⚠️ comment-rpc **没有** actuator 口（`spring.main.web-application-type: none`）
#    ⇒ 它的「在服务」判据降为 ①Nacos + ②端口 LISTEN（无 ③健康端点）

# ---- 服务发现 / 静态寻址 ----
COMMENT_RPC_ADDRESS=discovery:///comment-rpc
TASK_RPC_ADDRESS=static://127.0.0.1:9005   # ⚠️ devh 的 client 地址**必须带 scheme**（static:// / discovery://）

# ---- JWT 有效期（秒）----
USER_JWT_EXPIRE=31536000         # 365 天
ADMIN_JWT_EXPIRE=2592000         # 30 天
FAVORITE_JWT_EXPIRE=2592000      # 30 天
