<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId>
        <artifactId>follow</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>follow-proto</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        ⚠️ 本文件此前只有 properties 段：<dependencies> 与 <build> 都是空的，
        因此 follow-proto **从来没有生成过任何代码**，产出的是一个空 jar。
        放进 follow.proto 光有文件不够——没有 protoc 插件消费它，等于没放。

        这是 §3.3「不能仅凭「文件看起来像那么回事」推断能力存在」的一个实例。

        本段与 service/message/message-proto/pom.xml、service/article/article-proto/pom.xml
        **逐行同构**（那是本仓库里唯一已验证能产出 *Grpc.java 的模板）。
        不重新设计：换写法会把「protoc 平台二进制 / enforcer 版本下界」这两个已踩过的坑重新踩一遍。
    -->
    <dependencies>
        <!-- 生成代码 extends GeneratedMessageV3 / MessageLite -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <!-- 生成 gRPC service stub（FollowServiceGrpc.java 用到） -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>

        <!-- 部分 grpc-java 生成代码用到 @javax.annotation.Generated / @Nullable -->
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-javalite</artifactId>
            <version>${protobuf.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 必须显式声明 + 加 <extensions>true</extensions>，否则 ${os.detected.classifier}
                 注入时机晚于 protobuf-maven-plugin 的依赖解析，导致拉到错误平台的 native binary。 -->
            <plugin>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>

            <!-- ① 编译 follow.proto → 各 message / enum -->
            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <configuration>
                    <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
                    <pluginId>grpc-java</pluginId>
                    <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
                </configuration>
                <executions>
                    <execution>
                        <id>protobuf-compile</id>
                        <goals><goal>compile</goal></goals>
                    </execution>
                    <!-- 生成 *Grpc.java（含 server ImplBase + client Stub） -->
                    <execution>
                        <id>protobuf-compile-custom</id>
                        <goals><goal>compile-custom</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ② 把两个 generated-sources 目录加进 compile path -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-source</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources>
                                <source>target/generated-sources/protobuf/java</source>
                                <source>target/generated-sources/protobuf/grpc-java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-banned-dependencies</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.google.protobuf:protobuf-javalite:[,3.25.4]</exclude>
                                        <exclude>com.google.protobuf:protobuf-java:[,3.25.4]</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
