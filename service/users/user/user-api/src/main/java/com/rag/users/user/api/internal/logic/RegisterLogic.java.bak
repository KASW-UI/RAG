package com.rag.users.user.api.internal.logic;

import com.rag.common.logger.Logger;
import com.rag.users.common.errmsg.ErrorCode;
import com.rag.users.user.api.internal.metrics.Metrics;
import com.rag.users.user.api.internal.svc.ServiceContext;
import com.rag.users.user.api.internal.types.ApiTypes;
import com.rag.users.user.proto.CreateUserReq;
import com.rag.users.user.proto.CreateUserResp;
import io.grpc.Status;
import io.grpc.StatusRuntimeException;
import io.opentelemetry.context.Context;
import jakarta.servlet.http.HttpServletRequest;
import org.springframework.stereotype.Service;

/**
 * 对应 Go 端 internal/logic/user/registerlogic.go。
 *
 * <p>L1 外部契约 + L2 业务语义（三状态机，逐项冻结）：
 * <pre>
 *   1. 调 userRpc.Register(CreateUserReq{Username, Password, Email, ExtraInfo})
 *      → 失败：
 *         gRPC codes.Internal      → ErrorServerCommon (5001) + metrics "rpc_error"
 *         gRPC codes.AlreadyExists → ErrorUserExist    (1001) + metrics "rpc_error"
 *         其它（默认）              → CodeServerBusy   (1015) + metrics "rpc_error"
 *      → 成功：继续
 *
 *   2. 成功
 *      → Success (200) + metrics "success"
 *      → 返回 {uid: rpcResp.Uid}
 * </pre>
 *
 * <p>六个可观察面保留：
 * <ul>
 *   <li><b>Return</b>：成功时 {@code data.uid} 是字符串形式的 Snowflake UID；
 *       失败时 {@code code} 字段是 3 个 ErrorCode 之一</li>
 *   <li><b>Error</b>：3 个固定业务码（5001/1001/1015/200）</li>
 *   <li><b>Log</b>：rpc_error 时 logger.LogBusinessErr（不带用户名，与 Go 端一致）</li>
 *   <li><b>Metric</b>：2 个 result label（{@code rpc_error / success}）</li>
 * </ul>
 */
@Service
public class RegisterLogic {

    private final ServiceContext svcCtx;
    private final Metrics metrics;

    public RegisterLogic(ServiceContext svcCtx, Metrics metrics) {
        this.svcCtx = svcCtx;
        this.metrics = metrics;
    }

    /**
     * 对应 Go {@code func (l *RegisterLogic) Register(req *types.CreateUserReq) (resp *types.CreateUserResp, code int)}。
     */
    public LogicResult<ApiTypes.CreateUserResp> register(ApiTypes.CreateUserReq req, HttpServletRequest httpRequest) {
        Context otelCtx = Context.current();

        CreateUserReq rpcReq = CreateUserReq.newBuilder()
                .setUsername(req.getUsername())
                .setPassword(req.getPassword())
                .setEmail(req.getEmail() == null ? "" : req.getEmail())
                .putAllExtraInfo(req.getExtraInfo() == null ? java.util.Collections.emptyMap() : req.getExtraInfo())
                .build();

        CreateUserResp rpcResp;
        try {
            rpcResp = svcCtx.getUserRpc().register(rpcReq);
        } catch (StatusRuntimeException e) {
            metrics.getRegisterRpcError().increment();
            Logger.logBusinessErr(otelCtx, ErrorCode.ERROR.getCode(), e);
            Status.Code code = e.getStatus().getCode();
            if (code == Status.Code.INTERNAL) {
                return LogicResult.fail(ErrorCode.ERROR_SERVER_COMMON);
            }
            if (code == Status.Code.ALREADY_EXISTS) {
                return LogicResult.fail(ErrorCode.ERROR_USER_EXIST);
            }
            return LogicResult.fail(ErrorCode.CODE_SERVER_BUSY);
        }

        metrics.getRegisterSuccess().increment();
        ApiTypes.CreateUserResp resp = new ApiTypes.CreateUserResp();
        resp.setUid(rpcResp.getUid());
        return LogicResult.ok(resp);
    }
}