package com.rag.users.user.api.internal.logic;

import com.rag.common.logger.Logger;
import com.rag.users.common.errmsg.ErrorCode;
import com.rag.users.user.api.internal.identity.IdentityResolver;
import com.rag.users.user.api.internal.svc.ServiceContext;
import com.rag.users.user.api.internal.types.ApiTypes;
import com.rag.users.user.proto.UpdateUserReq;
import com.rag.users.user.proto.UpdateUserResp;
import io.grpc.Status;
import io.grpc.StatusRuntimeException;
import io.opentelemetry.context.Context;
import jakarta.servlet.http.HttpServletRequest;
import org.springframework.stereotype.Service;

/**
 * 对应 Go 端 internal/logic/user/updateuserlogic.go。
 *
 * <p>L1 外部契约 + L2 业务语义（5 状态机，逐项冻结）：
 * <pre>
 *   1. 从 request attribute "userId" 取 uid（Go 端 ctx.Value("userId").(json.Number).Int64()）
 *      → 缺失/类型错/≤0 → ErrorTokenRuntime (1006)
 *
 *   2. 调 userRpc.UpdateUser(UpdateUserReq{Uid, Username?, Password?, Email?, ExtraInfo?})
 *      → 失败：
 *         codes.Internal      → ErrorServerCommon (5001)
 *         codes.AlreadyExists → ErrorUserExist    (1001)
 *         codes.NotFound      → ErrorUserNotExist (1003)
 *         default             → CodeServerBusy    (1015)
 *
 *   3. 成功
 *      → Success (200) + 返回 {user}（4 字段，与 Go 端一致）
 * </pre>
 *
 * <p>六个可观察面保留：
 * <ul>
 *   <li><b>Return</b>：成功时 {@code data.user} 含 uid/username/email/extraInfo；失败时 4 个业务码</li>
 *   <li><b>Error</b>：4 个固定业务码（1006/5001/1001/1003/1015/200）</li>
 *   <li><b>Metric</b>：Go 端 UpdateUserLogic <b>无 metrics 埋点</b> —— 1:1 不补</li>
 * </ul>
 */
@Service
public class UpdateUserLogic {

    private final ServiceContext svcCtx;

    public UpdateUserLogic(ServiceContext svcCtx) {
        this.svcCtx = svcCtx;
    }

    /**
     * 对应 Go {@code func (l *UpdateuserLogic) Updateuser(req *types.UpdateUserReq) (resp *types.UpdateUserResp, code int)}。
     */
    public LogicResult<ApiTypes.UpdateUserResp> updateUser(ApiTypes.UpdateUserReq req, HttpServletRequest httpRequest) {
        Context otelCtx = Context.current();

        long uid;
        try {
            uid = IdentityResolver.claimedUID(httpRequest);
        } catch (IdentityResolver.ErrInvalidClaimException e) {
            Logger.logBusinessErr(otelCtx, ErrorCode.ERROR_TOKEN_RUNTIME.getCode(), e);
            return LogicResult.fail(ErrorCode.ERROR_TOKEN_RUNTIME);
        }

        UpdateUserReq.Builder builder = UpdateUserReq.newBuilder().setUid(uid);
        if (req.getUsername() != null) builder.setUsername(req.getUsername());
        if (req.getPassword() != null) builder.setPassword(req.getPassword());
        if (req.getEmail() != null) builder.setEmail(req.getEmail());
        if (req.getExtraInfo() != null) builder.putAllExtraInfo(req.getExtraInfo());

        UpdateUserResp rpcResp;
        try {
            rpcResp = svcCtx.getUserRpc().updateUser(builder.build());
        } catch (StatusRuntimeException e) {
            Logger.logBusinessErr(otelCtx, ErrorCode.ERROR.getCode(), e);
            Status.Code code = e.getStatus().getCode();
            if (code == Status.Code.INTERNAL) {
                return LogicResult.fail(ErrorCode.ERROR_SERVER_COMMON);
            }
            if (code == Status.Code.ALREADY_EXISTS) {
                return LogicResult.fail(ErrorCode.ERROR_USER_EXIST);
            }
            if (code == Status.Code.NOT_FOUND) {
                return LogicResult.fail(ErrorCode.ERROR_USER_NOT_EXIST);
            }
            return LogicResult.fail(ErrorCode.CODE_SERVER_BUSY);
        }

        com.rag.users.user.proto.UserInfo rpcUser = rpcResp.getUser();
        ApiTypes.UserInfo apiUser = new ApiTypes.UserInfo();
        apiUser.setUid(rpcUser.getUid());
        apiUser.setUsername(rpcUser.getUsername());
        if (rpcUser.getEmail() != null && !rpcUser.getEmail().isEmpty()) apiUser.setEmail(rpcUser.getEmail());
        if (rpcUser.getExtraInfoCount() > 0) apiUser.setExtraInfo(rpcUser.getExtraInfoMap());

        ApiTypes.UpdateUserResp resp = new ApiTypes.UpdateUserResp();
        resp.setUser(apiUser);
        return LogicResult.ok(resp);
    }
}