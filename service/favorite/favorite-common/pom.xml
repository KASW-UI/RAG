<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId>
        <artifactId>favorite</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>favorite-common</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
            FavoriteSpans（common/span/FavoriteSpans.java）用 io.opentelemetry.api 的
            GlobalOpenTelemetry / Tracer / Span 三个类型 —— 它们全在 opentelemetry-api 里。

            ⚠️ 【为什么本模块必须显式引它】：favorite-common 是 favorite-api 与 favorite-rpc
            共同依赖的域内私有模块，但**本模块自身**不引任何 OTel artifact
            ⇒ favorite-common 编译期拿不到 io.opentelemetry.api.*。
            ⚠️ 【为什么不用 spring-boot-starter-*】：本模块只需要 **API 面**（不装 SDK），
            真正的 SDK / exporter 由 favorite-api 与 favorite-rpc 各自装配
            （favorite-api 引 opentelemetry-exporter-otlp；favorite-rpc 的 SDK 来自共享层）。

            版本由 spring-boot-dependencies BOM 管理（spring-boot-starter-parent 提供），不写版本号。
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>

        <!--
            FavoriteGrpcError 构造 io.grpc.StatusException / 解析 StatusRuntimeException /
            读 Status.Code，这些类全在 grpc-api；grpc-stub 会传递依赖 grpc-api。
            引 grpc-stub 而不是直接引 grpc-api，是为了与 message-common / like-common 保持同源，
            并让版本由根 pom 的 dependencyManagement 统一管理（本模块不写死版本号）。

            本模块【不需要】jackson：Go 端 service/favorite/common/errmsg.go 没有 CodeError 结构体
            （unlike like / message 域），所以本域的 common 层没有 code/msg 的 JSON 契约，
            HTTP envelope 的序列化在 favorite-api 层，不在这里。
        -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>

        <!--
            focused test：错误码表 / 文案表 / 未知码回落 / bizCode 跨真 gRPC 传输往返。
            版本由 spring-boot-dependencies BOM 管理（spring-boot-starter-parent 提供），不写版本号。
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            真 in-process gRPC server + channel：FavoriteGrpcErrorRoundTripTest 需要证明
            「业务码藏在 description 文案里」这个本域唯一契约真的能跨传输往返，
            而不只是「同一个 Status 对象在内存里过一遍」——在内存里过一遍永远为真，
            证明不了 grpc-java 对 description 是否保真（这正是 like 域踩过的坑所在）。

            ⚠️ 必须显式写 ${grpc.version}：根 pom 的 dependencyManagement 没有收录 grpc-inprocess。
            且不能升版本——根 pom 已注明 grpc-inprocess 1.63.0 与更高版本内部类不兼容，
            全栈锁 1.63.0。favorite-common 本身不依赖传输层，故放 test scope。
        -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <version>${grpc.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>