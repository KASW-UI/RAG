<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId>
        <artifactId>users</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>users-common</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- BCrypt -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>

        <!--
          SchemaInitializer 用 org.springframework.jdbc.datasource.init.ScriptUtils
          执行 users 域 DDL（2026-10-21 起取代 Flyway，见 SchemaInitializer 的 javadoc）。

          ⚠️ users-common 是 user-rpc / admin-rpc / user-api / admin-api **四者共用**的模块，
             加依赖前必须确认它不会把不该拖进来的东西带进来：
             spring-jdbc 只依赖 spring-core / spring-beans / spring-tx，
             **不含任何 jakarta.servlet 引用** ——
             而 admin-rpc 是纯 gRPC 进程、刻意不引 servlet 依赖
             （见 AdminRpcApplication 上关于 scanBasePackages 的注释）。
             所以这一项对 admin-rpc 是安全的。
             对比：spring-boot-starter-data-jpa 会拖进 hibernate 与一堆自动配置，不可用。
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <!--
          GoStyleCoercion（E-3 根因 R1）需要 Jackson 的
          CoercionConfig / LogicalType / DeserializationFeature。

          ⚠️ 必须是 **Jackson 3（tools.jackson.core）**，不是 Jackson 2：
             本项目是 Spring Boot 4.0.8，spring-boot-starter-jackson 带进来的是
             tools.jackson:jackson-databind:3.x，MVC 用的就是它；
             而 com.fasterxml.jackson.core:jackson-databind:2.x 是从 com.rag:common
             间接来的**另一份**，两套 API 不通用（Jackson 3 的包名是 tools.jackson.databind，
             且 coercion 只能在 builder 上配、ObjectMapper 上没有 coercionConfigFor）。
             第一版误用 Jackson 2，编译通过但端点行为一条没变。

          ⚠️ 只声明 databind，**不要**声明 spring-boot-jackson / spring-boot-autoconfigure：
             admin-rpc 是纯 gRPC 进程，刻意不引 Spring Boot 自动配置（见
             AdminRpcApplication 关于 scanBasePackages 的注释）。
             JsonMapperBuilderCustomizer 由两个 api 模块自己注册。
        -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!--
          SchemaInitializer 打启动日志（建哪份脚本、成没成功）。slf4j-api 是纯 API 包、
          零传递依赖，与 service/common 的用法一致。
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!--
          测试。JwtUtil 的 zero-pad 曾被删掉过一次，导致 admin 默认密钥（15 字节）在
          登录签发时抛 WeakKeyException，而当时的测试用的是 55 字节专用密钥把问题遮住了。
          这里补一个最小测试依赖，把该不变量钉死。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>


</project>