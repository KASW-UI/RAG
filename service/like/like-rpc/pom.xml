<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId>
        <artifactId>like</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>like-rpc</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- ============== 1. 内部模块依赖 ============== -->
        <!--
            like-proto：LikeServiceGrpc（server ImplBase）+ 各 message 类。
            proto 文件已与 Go 端 like.proto 逐字节对齐（package pb、字段号、enum 值全同），
            所以生成物直接可用，不需要再改。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>like-proto</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
            like-common：LikeErrorCode / LikeErrorMessages / LikeGrpcError。
            like-rpc 是**纯 gRPC 进程**，不引 web，因此它不像 message-rpc 那样需要
            GlobalExceptionHandler —— 业务错误一律经 LikeGrpcError.grpcError(bizCode, msg)
            变成 StatusException 由 gRPC runtime 写上 wire。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>like-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
            message-proto：MessageServiceBlockingStub。
            Go 侧 svc.ServiceContext.MessageRpc = messageservice.NewMessageService(zrpc.MustNewClient(...))，
            唯一调用点 notifyArticleLiked → SendNotification（ARTICLE_LIKED 通知）。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>message-proto</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
            common（artifactId=common）：服务级共享能力，对应 Go 端 service/common/*：
              - LoggerFactoryBean / SnowflakeBean / Logger    ← Go common/logger + common/snowflake
              - RpcServerInterceptorFactory / Observability*   ← Go common/observability（超时/deadline/OTEL）
              - communityfact.{Wire,Dispatcher,AuthorityHandler,ProcessLogger}
                                                          ← Go common/communityfact（事实流公共契约）
              - persistence.DeadlineQueryTimeoutInjector / SqlTimeoutStatusTranslator
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <!-- ============== 2. Spring Boot 基础（纯 gRPC，不带 web） ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
            spring-boot-web-server：只为满足 nacos-discovery 的反射引用
            （org.springframework.boot.web.server.context.WebServerInitializedEvent）。
            不引它启动不了 Nacos 自动配置，但**不会**因此起 web 容器 —— 本服务无 WebApplicationType。
            与 message-rpc 完全同款。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-web-server</artifactId>
        </dependency>

        <!-- ============== 3. Redis（对应 Go zrpc 的 *redis.Redis）============== -->
        <!--
            ★ Go 侧 BizRedis = *redis.Redis（go-zero rest/redis，底层 go-redis v9）。
            职责：like_count / dislike_count / like_state / user_total_like 四个 Hash 读写，
                  user_like_list / target_liker_list 两个 ZSet 读写与分页，以及 LikeAction 的 Lua EVAL。

            为什么用 Spring Data Redis 而不是裸 Lettuce / Jedis：
              - Hash/ZSet/String 的 opsFor* 抽象正好覆盖 Go 侧用到的全部命令；
              - Lua 用 RedisTemplate.execute(RedisScript, keys, args) 这一条就够，
                不需要自己管连接与序列化细节；
              - 项目后续 like-api 也要读同一批 key，共用同一套 client 配置更省事。
            ⚠️ 真正的缺口不在「怎么发命令」而在**错误语义**，见 LikeRedisGateway 的类注释：
               Go 的 Hmget 失败返回空切片（⇒ 全部当 miss ⇒ 降级查 DB），
               而 Spring Data Redis 一律抛异常。必须显式适配，不能直接调 opsForHash().multiGet()。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ============== 4. Kafka（对应 Go go-queue kq.Pusher / kq.Queue）============== -->
        <!--
            ★ Go 侧两个 producer + 一个 consumer：
              - KafkaPusher（c.KafkaConf，topic=like_promotion_topic）→ LikeAction 里推 KafkaLikeMsg
              - HotEventPusher（mq 进程，topic=article-hot-events）→ outbox relay 推 ArticleHotEvent
              - TaskUserPusher / TaskArticlePusher（**可选**，broker/topic 为空则 Go 侧返回 nil 并整段跳过）
              - kq.Queue consumer（group=like-update-group, topic=like_promotion_topic, offset=first, consumers=8）

            Spring 侧对应：KafkaTemplate（producer）+ @KafkaListener（consumer）。
            两个 Task*Pusher 的「未配置即整体禁用」语义不能靠 @ConditionalOnProperty 丢，
            因为 Go 是**运行期 if pusher != nil** 分支 —— 见 LikeTaskProgressPublisher 的实现注释。
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- ============== 5. gRPC server + client ============== -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-core</artifactId>
        </dependency>
        <!-- @GrpcService 自动起 gRPC server（替代 zrpc.MustNewServer） -->
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-server-spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- @GrpcClient("message-rpc")：替代 zrpc.MustNewClient(c.MessageRpc) -->
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-client-spring-boot-starter</artifactId>
            <version>3.1.0.RELEASE</version>
            <exclusions>
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ============== 6. 数据访问：Postgres + MyBatis-Plus + Flyway ============== -->
        <!--
            对应 Go 端 gorm.Open(postgres.Open(...)) + db.AutoMigrate(...)。
            Go 侧 AutoMigrate 依据 struct tag 生成 5 张表；Java 侧改由 Flyway V*__create_*.sql 显式建表，
            列类型 / 索引 / 唯一约束 / NOT NULL / DEFAULT 与 GORM 产物逐条对齐。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <!--
                ⚠️ 刻意不加 <scope>runtime</scope>：JsonbTypeHandler 在**编译期**就要引用
                org.postgresql.util.PGobject 来把参数显式声明成 jsonb 类型。
                改成 runtime 会编译失败（message-rpc 不需要它所以能设 runtime）。
            -->
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
            ⚠️ spring-boot-flyway 是必需的（与 message-rpc 同款，DRIFT-MSG-006）。
            Boot 4 把自动配置拆成按技术分模块：flyway-core 只是引擎本身，
            真正让 spring.flyway.* 生效并在启动期跑 classpath:db/migration 的是本模块。
            缺它时**启动日志里连一行 Flyway 都没有**（不是报错，是根本没加载），
            5 张表永不创建 ⇒ 第一次真正执行 SQL 才炸。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- ============== 7. Metrics ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- ============== 8. Nacos 服务发现 ============== -->
        <!--
            对应 Go zrpc.MustNewServer 的 Etcd 注册（etc/like.yaml Etcd.Key: like.rpc）。
            ⚠️ 与 message-rpc 同款的两个约束：
              1. 不引 spring-boot-starter-web —— 否则纯 gRPC 进程会被拉起 web 容器；
              2. NacosRegistration 用显式 Bean 名避开 NacosServiceRegistryAutoConfiguration 的同名 Bean
                 （DRIFT-MSG-004）。
        -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- ============== 9. 测试 ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            ⚠️ 必须显式写版本：根 pom 的 dependencyManagement 只管 grpc-stub / -core /
            -netty-shaded / -protobuf / -protobuf-lite，**没有**管 grpc-inprocess，
            漏写版本会让整个 reactor 在读 POM 阶段就失败
            （'dependencies.dependency.version' for io.grpc:grpc-inprocess:jar is missing），
            连 like-api 都一起构建不了。与 like-common 的写法保持一致。
        -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <version>${grpc.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
            真 PostgreSQL（不是 H2）：like_record 上有 uk_user_target 复合唯一约束 +
            like_fact_stream 依赖 INSERT..ON CONFLICT..RETURNING 递增版本号，
            而「唯一冲突必须整事务回滚」与「版本号原子递增」正是本模块要验证的不变量。
            H2 在这两点上与 PG 行为不同，替换等于把要验证的东西换没了。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                集成测试必须关掉 Ryuk，否则在本机/CI 上起不了任何容器。
                原因与恢复方式见 message-rpc/pom.xml 同款注释（Testcontainers 2.x 的
                ResourceReaper 只读环境变量 TESTCONTAINERS_RYUK_DISABLED，
                testcontainers.properties 与 -D 均无效，只有 surefire 注入 env 才有效）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>