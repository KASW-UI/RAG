<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId>
        <artifactId>favorite</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>favorite-rpc</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        ⚠️ 迁移前本文件只有 <artifactId> 与 <properties>：**零 <dependencies>、零 build 插件**。
        那不是「精简」，是「从来没有编译过一行 Java」—— 没有 protoc 消费、没有 gRPC、没有
        数据访问、没有 Flyway。与 like-rpc 的空壳是同一种状态。
        本段依赖清单逐条对应 Go 侧 service/favorite/rpc 的真实依赖面
        （推导依据：docs/FileTree/favorite/rpc.md §12.4 末行）。
    -->
    <dependencies>
        <!-- ============== 1. 内部模块依赖 ============== -->
        <!--
            favorite-proto：FavoriteServiceGrpc（server ImplBase）+ 7 组 Req/Resp + FavoriteFolder/FavoriteItem。
            proto 已与 Go 端 proto/favorite.proto 对齐（只差 option 块：go_package → java_package），
            ⇒ 生成的 *Grpc 方法路径 /favorite.FavoriteService/* 与 Go 相同，零 wire 偏离。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>favorite-proto</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
            favorite-common：FavoriteErrorCode / FavoriteErrorMessages / FavoriteGrpcError。
            🔴 本域与 like 域的关键差异：FavoriteGrpcError.grpcError(Status.Code, int bizCode)
            收的是「**标准** gRPC 码 + 业务码」，业务码靠 description 文案反查还原
            （见 FavoriteGrpcError 的类注释与 docs/FileTree/favorite/common.md）。
            纯 gRPC 进程不需要 GlobalExceptionHandler（那是 api 侧的事）。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>favorite-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
            user-proto：UserServiceGrpc + GetUserReq{uid} / GetUserResp{user, found} / UserInfo。
            Go 出处：internal/svc/service_context.go:37
              UserRpc: userservice.NewUserService(zrpc.MustNewClient(c.UserRpc))
            🔴 UserInfo.status 是 **optional int64**（users.proto:12）——
            Go 的 `resp.User.Status == nil` 是 presence 检查，Java 侧必须 hasStatus()。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>user-proto</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
            article-proto：ArticleServiceGrpc + GetArticleRequest{article_id, incr_view, public_only, requester_id}
            / GetArticleResponse{article} / Article{... ext_info=16} / ArticleStatus.PUBLISHED=2。
            Go 出处：internal/svc/service_context.go:38
              ArticleRpc: articleservice.NewArticleService(zrpc.MustNewClient(c.ArticleRpc))
            🔴 IncrView=false 与 PublicOnly=true 都是 L1（helper.go:133-137）。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>article-proto</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
            common（artifactId=common）：服务级共享能力，对应 Go 端 service/common/*：
              - LoggerFactoryBean / SnowflakeBean / Logger / FatalError
                                                  ← Go common/logger + common/snowflake
              - RpcServerInterceptorFactory / Observability* / DeadlineQueryTimeoutInjector
                                                  ← Go common/observability（超时/deadline/OTEL）
              - communityfact.{Wire,Dispatcher,AuthorityHandler,ProcessLogger}
                                                  ← Go common/communityfact（事实流公共契约）
            favorite 域对 Wire 的复用度最高：FavoriteWireEvent / FavoriteTechnicalReceipt /
            DCEventSender / canonicalHash(JCS) / strictDecode / validateReceipt 全部直接取用。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <!-- ============== 2. Spring Boot 基础（纯 gRPC，不带 web） ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
            spring-boot-web-server：**只为满足 nacos-discovery 的反射引用**
            （org.springframework.boot.web.server.context.WebServerInitializedEvent）。
            不引它启动不了 Nacos 自动配置。
            ⚠️ **2026-10-26 第十七轮更正**：本注释原文写「**不会**因此起 web 容器 ——
            本服务无 WebApplicationType」—— **那句是错的**。
            真正决定 web 应用类型的是**classpath 上有没有 jakarta.servlet**（见下一条依赖），
            不是有没有引 spring-boot-web-server。
            ⇒ 本模块因为下面那条 `jakarta.servlet-api`，Boot 会判定成 **SERVLET** web app
            ⇒ 必须靠 `spring.main.web-application-type: none`（production application.yml）压回去
            ⇒ 少了那一行，**真 fat jar 启动即死**（实测：no ServletWebServerFactory bean defined）。
            与 like-rpc / message-rpc 的差异：那两个模块**没有**这条 jakarta.servlet 依赖
            ⇒ 它们的 classpath 上没有 servlet ⇒ Boot 判定 NONE ⇒ 不需要那行配置。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-web-server</artifactId>
        </dependency>
        <!--
            ⚠️ servlet-api 在 common 里是 `provided`，**不传递给消费者**
            （Maven 的 provided 既不传递也不打包）。而 favorite 侧要编译
            fact/FavoriteAuthorityEndpointConfig（Go internal/authority/http.go 的 Servlet 等价物）
            就必须能编译期引用 jakarta.servlet.http.HttpServlet/Request/Response。

            ⚠️ 这里刻意**不用** provided（与 common 相反）：
            provided 意味着运行期也不在 classpath ⇒ Spring 组件扫描加载
            FavoriteAuthorityEndpointConfig 时会抛 NoClassDefFoundError，
            而它是带 @Configuration 的类，扫描阶段就会触发 ⇒ **整个容器起不来**。
            （这正是 AGENTS.md §3.3「不能凭声明推断能力存在」的同型问题：
            本模块的 like/message 域都没写过 authority 端点，所以从未踩到。）

            🔴🔴 **2026-10-26 第十七轮更正（本注释原文有两句都错）**：
            原文写「jakarta.servlet-api 是纯 API jar，**加进运行时 classpath 不会启动任何容器**；
            favorite-rpc 仍然是 WebApplicationType.NONE 的纯 gRPC 进程」—— **前半句是错的**：
            正是**因为它在运行时 classpath 上**，Spring Boot 的
            `WebApplicationType.deduceFromClasspath()` 才把本进程判定成 **SERVLET** web app
            ⇒ 而本服务没有 servlet 容器 ⇒ 启动期报
            「no org.springframework.boot.web.server.servlet.ServletWebServerFactory bean defined」
            ⇒ **真 fat jar 起不来**（2026-10-26 实测）。
            ⇒ 修法是**配置层**压回去：`spring.main.web-application-type: none`
            （production application.yml）⇒ 显式声明「不是 web 应用」。

            ⚠️ 原文的另一半「与 Go etc/favorite.yaml 只有 ListenOn: 8082 一致」**也错**：
            Go 侧除了 8082 还有 go-zero 内置的 DevServer（etc/favorite.yaml:23-30 →
            0.0.0.0:16062 的 /metrics / /healthz / pprof；`internal/devserver/server.go:79-82`
            的 `if !c.Enabled { return }` ⇒ **与 mode 无关，生产也开**）——
            那是 **go-zero 自带的 HTTP server，不依赖 servlet 容器**。
            ⇒ RAG 侧因此**没有** 16062 那个面 ⇒ **这本身是一条与 Go 的偏离**，
            已单独登记为域内未决项 **U9**（部署形态类，待拍板）⇒ **不与本条混谈**。
            ⚠️ 真要<b>开启</b>权威读端点（favorite.fact.authority.enabled=true），
            还需运维另加一个 servlet 容器（tomcat / jetty），那是部署形态变更，
            见剩余问题。
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>
        <!--
            ServletRegistrationBean 所在的 spring-boot-web-server 已在上方声明；
            @ConditionalOnProperty 来自 spring-boot-autoconfigure（starter 已传递）。
        -->

        <!-- ============== 3. gRPC server + client ============== -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-core</artifactId>
        </dependency>
        <!-- @GrpcService 自动起 gRPC server（替代 zrpc.MustNewServer） -->
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-server-spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- @GrpcClient("user-rpc") / @GrpcClient("article-rpc")：替代 zrpc.MustNewClient -->
        <!--
            ⚠️ 这个 <version> 是必需的，**不是**冗余：
            根 pom 的 <dependencyManagement> 只管理了 grpc-**server**-spring-boot-starter
            （pom.xml:178-182），没有管理 grpc-**client**-spring-boot-starter。
            message-rpc / like-rpc / article-rpc 三个模块各自显式写了
            `<version>3.1.0.RELEASE</version>`，本模块漏写 ⇒
            `'dependencies.dependency.version' for net.devh:grpc-client-spring-boot-starter:jar is missing`
            ⇒ **整个 reactor 的 POM 解析失败**，任何模块都构建不了
            （连 `-pl service/task/task-rpc -am` 也会在读 POM 阶段就挂掉）。
            取值与根 pom 的 ${grpc-spring-boot-starter.version} 一致。
        -->
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-client-spring-boot-starter</artifactId>
            <version>${grpc-spring-boot-starter.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ============== 4. 数据访问：Postgres + MyBatis-Plus + Flyway ============== -->
        <!--
            对应 Go 端 gorm.Open(postgres.Open(...)) + db.AutoMigrate(3 实体) + 4 个手写 SQL。
            ⚠️ Go 的 DDL 事实源有**两处**（AutoMigrate 只覆盖 FavoriteFolder/FavoriteItem/
            FavoriteFactOutbox 三个；CHECK / 部分索引 / 两个不可变触发器 / legacy 标记表
            全部只能靠手写 SQL）⇒ Java 侧 V1..V6 必须**一次性建全**，不能只搬 struct tag。
            详见 docs/FileTree/favorite/rpc.md §12.3 的「三条硬结论」。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <!--
                ⚠️ 刻意不加 <scope>runtime</scope>：JsonbTypeHandler 在**编译期**就引用
                org.postgresql.util.PGobject 把参数显式声明成 jsonb 类型。
                改成 runtime 会编译失败（与 like-rpc 同款）。
            -->
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
            ⚠️ spring-boot-flyway **不可省**（与 message-rpc / like-rpc 同款）。
            Boot 4 把自动配置拆成按技术分模块：flyway-core 只是引擎本身，
            真正让 spring.flyway.* 生效并在启动期跑 classpath:db/migration 的是本模块。
            缺它时**启动日志里连一行 Flyway 都没有**（不是报错，是根本没加载），
            4 张表永不创建 ⇒ FavoriteSchemaGate 会报 ERROR，首次真正执行 SQL 才炸。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- ============== 5. Metrics ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!--
            🔴 spring-boot-starter-web：**只为给 Actuator 一个 servlet 载体**
            ⇒ 让 `management.endpoints.web.exposure.include: prometheus` 真正有出口。

            【Go 出处（真源 · 消费点）】—— favorite 域走的是 **DevServer 型**（不是 Prometheus 块）
              service/favorite/rpc/etc/favorite.yaml:23-30
                  DevServer: {Enabled: true, Host: 0.0.0.0, Port: 16062,
                              MetricsPath: /metrics, HealthPath: /healthz,
                              EnableMetrics: true, EnablePprof: true}
              ⇒ go-zero 的 zrpc.RpcServerConf **内嵌** service.ServiceConf
                 （go-zero@v1.10.2/zrpc/config.go:39）
              ⇒ ServiceConf.DevServer 字段（go-zero@v1.10.2/core/service/serviceconf.go:40）
              ⇒ ⇒ 消费点 zrpc/server.go:63 `c.SetUp()`
                 ⇒ ⇒ core/service/serviceconf.go:77 `devserver.StartAgent(sc.DevServer)`
                 ⇒ ⇒ internal/devserver/server.go:79-82 `if !c.Enabled { return }`
                 ⇒ ⇒ internal/devserver/server.go:42 HealthPath / :48 MetricsPath
                    / :53-57 pprof / :70-73 **独立端口** `http.ListenAndServe(addr, s.server)`
              ⇒ ⇒ Go 侧 favorite-rpc **真的**在 0.0.0.0:16062 起了一个 HTTP 服务
                 （`/metrics` + `/healthz` + `/debug/pprof/*`）。

            【为什么以前「有 actuator 却抓不到」】—— AGENTS.md §3.3 的典型形态：
              `spring-boot-starter-actuator` 只提供 **endpoint + 自动配置**，
              **不提供 servlet 容器** ⇒ `management.endpoints.web.*` 这一族配置
              **没有任何载体** ⇒ **配了也不生效**（不是报错，是那一族自动配置根本不加载）。
              ⇒ 本模块的 yml 早就写了 exposure.include，但它一直是**死配置**。

            【⚠️ 与本模块那条注释的关系（原注释已订正）】
              原注释写「不引 spring-boot-starter-web，否则纯 gRPC 进程会被拉起 web 容器」——
              ⚠️ **那句话的因果是反的**：本模块 classpath 上**本来就有**
              `jakarta.servlet:jakarta.servlet-api`（编译期引用 HttpServlet/Request/Response）
              ⇒ Boot 的 `WebApplicationType.deduceFromClasspath()` 判定本进程**已经是**
              SERVLET web 应用 ⇒ ⇒ **「不引 starter 就不会起 web 容器」是假的**；
              真正让它起不来的原因是**没有容器实现**（没有 Tomcat）
              ⇒ ⇒ 报「no ServletWebServerFactory bean defined」。
              ⇒ 现在补上 starter ⇒ **容器有了** ⇒ 之前那条「用 `web-application-type: none`
                把 web 类型钉成 NONE」的**缓解手段就不该再留**（它会把刚补上的载体又关掉）
              ⇒ ⇒ yml 侧的 `spring.main.web-application-type` 一并反转（见该文件）。

            【Boot 4 拆模块纪律（AGENTS.md §3.3 · 先确认能力还在不在，再决定补哪个模块）】
              - `WebEndpointAutoConfiguration`（actuator 的 servlet web endpoint 映射）
                **仍在** `spring-boot-actuator-autoconfigure` ✔（已在 classpath 上）
              - `PrometheusScrapeEndpoint` + `PrometheusMetricsExportAutoConfiguration`
                在 **`spring-boot-micrometer-metrics`**（`spring-boot-starter-actuator` 传递引入）✔
              ⇒ **唯一缺的就是 servlet 容器 + Spring MVC**
              ⇒ 补 `spring-boot-starter-web`（Boot 4 里它 = starter-tomcat + webmvc + http-converter）
                 **版本由 spring-boot-dependencies BOM 管 ⇒ 不写 `<version>`**。

            【⚠️ 进程形态变了 —— 这是「暴露形态差异」，按 twoStage.md §10 登记】
              Go 侧是 go-zero `devserver` 的**小 server**（无 servlet、无业务路由）；
              RAG 侧是 **Tomcat**（有 servlet 容器，但**没有任何业务 HTTP 路由**）。
              ⇒ 两者的**对外可观测面**（独立端口 16062 + Prometheus 文本）一致，载体不同
              ⇒ 登记为暴露形态差异项（与 follow 域 DRIFT-FOLLOW-006 同款）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ============== 6. Nacos 服务发现 ============== -->
        <!--
            对应 Go zrpc.MustNewServer 的 Etcd 注册（etc/favorite.yaml Etcd.Key: favorite.rpc）。
            FavoriteNacosRegistration 用显式 Bean 名避开 NacosServiceRegistryAutoConfiguration 的同名 Bean。
        -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- ============== 7. 测试 ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            ⚠️ 必须显式写版本：根 pom 的 dependencyManagement 只管 grpc-stub / -core /
            -netty-shaded / -protobuf / -protobuf-lite，**没有**管 grpc-inprocess，
            漏写版本会让整个 reactor 在读 POM 阶段就失败。

            🔴🔴🔴 **scope 必须是 runtime，不能是 test**（2026-10-25 第十四轮实测钉死）：
            devh 的 `GrpcClientAutoConfiguration.shadedNettyGrpcChannelFactory`
            （grpc-client-spring-boot-starter 3.1.0.RELEASE:160）在**运行期**会引用
            `io.grpc.inprocess.InProcessChannelBuilder`（它要挂一个 in-process 兜底通道）⇒
            运行时 classpath 缺这个类 ⇒ **进程起不来**：

                java.lang.NoClassDefFoundError: io/grpc/inprocess/InProcessChannelBuilder
                  at net.devh.boot.grpc.client.autoconfigure.GrpcClientAutoConfiguration
                     .shadedNettyGrpcChannelFactory(GrpcClientAutoConfiguration.java:160)

            ⚠️ 这个缺陷被 `@SpringBootTest` **完全掩盖**了：测试上下文的 classpath
            含 test scope ⇒ 永远走不到这条分支 ⇒
            「测试全绿」与「jar 能跑」是两件事（本仓 `check-jar-executable.sh` 查的也只是
            Main-Class，查不出「少一个运行时依赖」）。
            ⇒ 2026-10-25 起 favorite-rpc / favorite-api **都必须能以 `java -jar` 真起一次**。
        -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <version>${grpc.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!--
            真 PostgreSQL（不是 H2）：favorite_fact_outbox 上有 UNIQUE(favorite_id,aggregate_version)
            + CHECK(aggregate_version IN (1,2)) + 两个 BEFORE UPDATE 不可变触发器，
            而「唯一冲突必须整事务回滚」「FOR UPDATE SKIP LOCKED 多 dispatcher 并发」
            正是本域要验证的不变量。H2 既没有 plpgsql 触发器也不认 SKIP LOCKED ⇒ 替换等于换没了。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                集成测试必须关掉 Ryuk，否则在本机/CI 上起不了任何容器。
                原因与恢复方式见 message-rpc/pom.xml 与 like-rpc/pom.xml 的同款注释
                （Testcontainers 2.x 的 ResourceReaper 只读环境变量 TESTCONTAINERS_RYUK_DISABLED）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>