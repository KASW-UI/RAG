package com.rag.users.user.api.internal.logic;

import com.rag.common.logger.Logger;
import com.rag.users.common.errmsg.ErrorCode;
import com.rag.users.user.api.internal.identity.IdentityResolver;
import com.rag.users.user.api.internal.svc.ServiceContext;
import com.rag.users.user.api.internal.types.ApiTypes;
import com.rag.users.user.proto.UploadAvatarReq;
import com.rag.users.user.proto.UploadAvatarResp;
import io.grpc.Status;
import io.grpc.StatusRuntimeException;
import io.opentelemetry.context.Context;
import jakarta.servlet.http.HttpServletRequest;
import org.springframework.stereotype.Service;

/**
 * 对应 Go 端 internal/logic/user/uploadavatarlogic.go。
 *
 * <p>L1 外部契约 + L2 业务语义（5 状态机，逐项冻结）：
 * <pre>
 *   1. AvatarHelpers.currentUserID(request) 取 uid
 *      → 失败 → ErrorTokenRuntime (1006)
 *
 *   2. avatar_url 空字符串检查（strings.TrimSpace(req.AvatarUrl) == ""）
 *      → Error (500)
 *
 *   3. avatar_url trim（TrimSpace 后传给 RPC，与 Go 一致）
 *
 *   4. 调 userRpc.UploadAvatar(UploadAvatarReq{Uid, AvatarUrl, ContentType?, SizeBytes?})
 *      → 失败：
 *         codes.InvalidArgument → Error           (500)
 *         codes.NotFound        → ErrorUserNotExist (1003)
 *         codes.Internal        → ErrorServerCommon (5001)
 *         default               → CodeServerBusy   (1015)
 *
 *   5. 成功
 *      → Success (200) + 返回 {avatarUrl, history}
 *      → history 由 AvatarHelpers.avatarHistoryItemFromPB 转换
 * </pre>
 *
 * <p>六个可观察面保留：
 * <ul>
 *   <li><b>Return</b>：成功时 {@code data.avatarUrl} + {@code data.history}（6 字段 DTO）</li>
 *   <li><b>Metric</b>：Go 端 UploadAvatarLogic <b>无 metrics 埋点</b> —— 1:1 不补</li>
 * </ul>
 */
@Service
public class UploadAvatarLogic {

    private final ServiceContext svcCtx;
    private final AvatarHelpers avatarHelpers;

    public UploadAvatarLogic(ServiceContext svcCtx, AvatarHelpers avatarHelpers) {
        this.svcCtx = svcCtx;
        this.avatarHelpers = avatarHelpers;
    }

    /**
     * 对应 Go {@code func (l *UploadavatarLogic) Uploadavatar(req *types.UploadAvatarReq) (resp *types.UploadAvatarResp, code int)}。
     */
    public LogicResult<ApiTypes.UploadAvatarResp> uploadAvatar(ApiTypes.UploadAvatarReq req,
                                                                HttpServletRequest httpRequest) {
        Context otelCtx = Context.current();

        long uid;
        try {
            uid = avatarHelpers.currentUserID(httpRequest);
        } catch (IdentityResolver.ErrInvalidClaimException e) {
            Logger.logBusinessErr(otelCtx, ErrorCode.ERROR_TOKEN_RUNTIME.getCode(), e);
            return LogicResult.fail(ErrorCode.ERROR_TOKEN_RUNTIME);
        }

        // Go: strings.TrimSpace(req.AvatarUrl) == "" 检查
        String avatarUrl = req.getAvatarUrl() == null ? "" : req.getAvatarUrl().trim();
        if (avatarUrl.isEmpty()) {
            Logger.logBusinessErr(otelCtx, ErrorCode.ERROR.getCode(),
                    new RuntimeException("avatar_url is empty"));
            return LogicResult.fail(ErrorCode.ERROR);
        }

        UploadAvatarReq.Builder builder = UploadAvatarReq.newBuilder()
                .setUid(uid)
                .setAvatarUrl(avatarUrl);
        if (req.getContentType() != null) builder.setContentType(req.getContentType());
        if (req.getSizeBytes() != null) builder.setSizeBytes(req.getSizeBytes());

        UploadAvatarResp rpcResp;
        try {
            rpcResp = svcCtx.getUserRpc().uploadAvatar(builder.build());
        } catch (StatusRuntimeException e) {
            Logger.logBusinessErr(otelCtx, ErrorCode.ERROR.getCode(), e);
            Status.Code code = e.getStatus().getCode();
            if (code == Status.Code.INVALID_ARGUMENT) {
                return LogicResult.fail(ErrorCode.ERROR);
            }
            if (code == Status.Code.NOT_FOUND) {
                return LogicResult.fail(ErrorCode.ERROR_USER_NOT_EXIST);
            }
            if (code == Status.Code.INTERNAL) {
                return LogicResult.fail(ErrorCode.ERROR_SERVER_COMMON);
            }
            return LogicResult.fail(ErrorCode.CODE_SERVER_BUSY);
        }

        ApiTypes.UploadAvatarResp resp = new ApiTypes.UploadAvatarResp();
        resp.setAvatarUrl(rpcResp.getAvatarUrl());
        resp.setHistory(avatarHelpers.avatarHistoryItemFromPB(rpcResp.getHistory()));
        return LogicResult.ok(resp);
    }
}