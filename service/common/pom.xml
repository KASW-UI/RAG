<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId>
        <artifactId>service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>common</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <opentelemetry.version>1.44.0</opentelemetry.version>
        <java-json-canonicalization.version>1.1</java-json-canonicalization.version>
    </properties>

    <!-- 统一管理 OpenTelemetry 各模块版本，避免子模块手写版本号 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.22.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ============ 0. Spring Boot starter（Spring 化入口，Bean 化所需） ============ -->
        <!--
            引入 spring-boot-starter 让 common 模块可以定义 @Component / @Configuration / @Value /
            @ConfigurationProperties 等 Spring 注入能力。注意这是 common 模块首次引入 Spring 依赖，
            是不可逆决策——common 不再是"框架无关库"，而是 Spring Boot 模块。
            当前业务模块继续使用 static 入口；Spring Bean 入口作为未来平滑迁移的备份路径。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- ============ 1. 日志门面 + 实现（替代 go-zero logx） ============ -->
        <!--
            对应 Go 版 logger/logger.go 中 logx.WithContext(ctx).Errorw / Infow 的日志输出：
            Go 版用 go-zero 自带的 logx（封装 zap），Java 版走 SLF4J 门面 + logback-classic 实现
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!--
            logback-classic：**移除硬编码版本号**，交由 spring-boot-starter-parent 的
            dependencyManagement 统一管理（logback-core 也由它管理）。

            为什么改：此前这里钉死 1.6.3，而同一模块的 logback-core 被 spring-boot-starter-parent
            解析成 1.5.38（dependencyManagement 优先级高于传递依赖）—— 两者 API 不兼容，
            任何真正启动的 Spring Boot 应用都会在日志初始化阶段抛：
                java.lang.AbstractMethodError: Receiver class ch.qos.logback.classic.PatternLayout
                does not define or inherit an implementation of the resolved method
                'abstract java.util.Map getDefaultConverterMap()'
                            of abstract class ch.qos.logback.core.pattern.PatternLayoutBase

            这个缺陷此前能长期潜伏，正是因为 service/common 的 9 个测试全是纯单元测试 ——
            不起 Spring 容器就永远走不到 LoggingApplicationListener。
            加了 ObservabilityWiringTest（@SpringBootTest）后第一次被暴露出来。

            能力校验：ProcessLogger 用到的 ILoggingEvent#getKeyValuePairs() 自 logback 1.3.0 起提供，
            由父 pom 管理的版本满足，无需降级功能。
        -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- ============ 2. OpenTelemetry：tracing + context propagation ============ -->
        <!--
            对应 Go 版 observability/*.go + communityfact/{logging,authority_http}.go 中
            go.opentelemetry.io/otel/* 的 Span / TracerProvider / TextMapPropagator 用法

            🔴 2026-10-25（第十九轮 · global T-8）：**opentelemetry-api 原来手写了 1.62.0**，
            而同模块的 opentelemetry-context / opentelemetry-sdk / opentelemetry-sdk-testing
            都由上面的 opentelemetry-bom（1.44.0）管 ⇒ **本模块自己 classpath 上版本错配**。
            ⇒ 实测后果（真跑，不是推断）：api 1.62.0 的 W3CBaggagePropagator 会调用
               `TextMapGetter.getAll(carrier, key)`，而 context 1.44.0 的 TextMapGetter
               **没有这个方法**（1.55.0 才加）⇒ 运行时
               `NoSuchMethodError: io.opentelemetry.context.propagation.TextMapGetter.getAll`
               ⇒ 凡是走 baggage propagator 的 extract 路径都会炸。
            ⇒ 修法：**不写版本号**，统一由 BOM（${opentelemetry.version} = 1.44.0）管
               —— 这本来就是本段注释写着的意图（「统一管理 OpenTelemetry 各模块版本，
               避免子模块手写版本号」）。
            ⚠️ **对 10 个 api 模块零影响**：它们的 otel 版本由**根 pom 的 Spring Boot BOM**
               （1.55.0）管 ⇒ 实测 hot-api 的 otel 全家是 1.55.0（api/context/sdk 同版本）
               ⇒ 本模块改版本**不会**改变 api 进程实际跑的版本。
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-context</artifactId>
        </dependency>

        <!--
            🔴 2026-10-25（第二十一轮 · global T-11）：**OTLP exporter** ——
            对应 Go 侧 core/trace/agent.go:114-121（if len(c.Endpoint) > 0 才装 batcher）
            与各服务 etc/*.yaml 的 `Telemetry: { Endpoint: jaeger:4317, Batcher: otlpgrpc }`。

            为什么必须是 **compile（非 optional）**：装配点在本包内的
            GoStyleOtelAutoConfiguration ⇒ **凡依赖 service/common 的进程都会加载它**
            ⇒ exporter 的类必须对所有下游可见 ⇒ optional=true 会让运行时 NoClassDefFoundError。
            （对比：grpc-client-spring-boot-starter 用 optional=true，是因为只有本包自己用。）

            ⚠️ 版本**不写**：由上面的 opentelemetry-bom（${opentelemetry.version} = 1.44.0）管
            ⇒ 与同模块的 api / sdk / context 同版本 ⇒ 不会出现「api 1.62 + sdk 1.44」那种错配。
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- ============ 3. gRPC server interceptor（替代 go-zero zrpc） ============ -->
        <!--
            对应 Go 版 observability/rpc.go 的 grpc.UnaryServerInterceptor；
            grpc-stub 包含 grpc-api，足够写服务端拦截器
        -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>

        <!-- ============ 3a. gRPC **client** 全局拦截器（Go zrpc client 熔断，2026-10-22） ============ -->
        <!--
            对应 Go 版 zrpc 的 client breaker：
              - zrpc/internal/config.go:14  ClientMiddlewaresConf.Breaker bool `json:",default=true"`
              - zrpc/internal/client.go:112-113  if c.middlewares.Breaker { append(..., BreakerInterceptor) }
            ⚠️ Go 的 yaml 里一个字都没写，但 breaker **默认开**（同 §3.3.1）。

            为什么 optional=true（同 spring-web 那条的理由，但后果更严重）：
              com.rag.common 是**所有**业务模块的公共下游。若用普通 compile，
              devh grpc-client starter 会沿 Maven 传递给 like-common / users-common /
              hot-common / message-common …… 即每一个只需要一个错误码表的纯库模块，
              都会拖进一整套 gRPC 客户端栈 + Nacos + 服务发现自动配置。
              optional=true 表示：common 自己能编译 com.rag.common.protection 下那个
              ClientInterceptor，但**不传递给下游**。真正要用它的 api 模块自己显式声明。

            运行期安全性：GoStyleGrpcClientBreakerInterceptor 上挂了
            @ConditionalOnClass(GrpcGlobalClientInterceptor.class)，
            没有 devh starter 的进程在**类加载之前**就被条件挡掉，不会 NoClassDefFoundError。
            这不是预防性洁癖：本模块声明的是 optional，依赖方**不保证**有它，
            「声明方自己也不该假设下游有」是 optional 的基本契约。
        -->
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-client-spring-boot-starter</artifactId>
            <version>${grpc-spring-boot-starter.version}</version>
            <exclusions>
                <!-- 与 message-api / like-api 同款：devh 默认拖 grpc-core 1.63.0，版本统一由根 pom 管 -->
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-core</artifactId>
                </exclusion>
            </exclusions>
            <optional>true</optional>
        </dependency>

        <!-- ============ 3b. MyBatis 拦截器（B-1 超时缓解，2026-10-21） ============ -->
        <!--
            对应 Go 版 context.WithTimeout 到点后 database/sql 主动取消查询的语义。
            Go 侧不需要任何额外依赖（database/sql 内建）；Java 侧必须借 MyBatis 的
            Interceptor 钩子把 deadline 落到 Statement.setQueryTimeout 上。

            ⚠️ 这里只要 **mybatis 本体**，不要 mybatis-plus-boot-starter：
            starter 会带 MybatisPlusAutoConfiguration，把所有依赖本模块的服务
            （含纯 gRPC 进程与无数据源的 api 模块）都拖进自动配置扫描范围。
            mybatis 本体是纯 jar、零自动配置，任何模块引它都不会凭空多出 Bean。

            ⚠️ 版本必须与 user-rpc / admin-rpc 实际解析到的一致（当前 3.5.19，
            由 mybatis-plus 传递进来），否则同一个 Executor 接口可能被加载两份
            —— 拦截器的 type/signature 匹配会静默失效（§3.3：不报错的失效）。
        -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
        </dependency>

        <!-- ============ 4. Jakarta Servlet API（替代 go-zero rest middleware） ============ -->
        <!--
            对应 Go 版 observability/http.go 的 rest.Middleware / http.HandlerFunc；
            Java 侧用 Servlet Filter 等价物，scope=provided 由运行容器提供实现
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ============ 4a. Spring MVC / Lettuce（**provided** · 2026-10-27 新增） ============ -->
        <!--
            ⚠️ 为什么是 provided 而不是 compile：**provided 依赖不传递** ⇒
            这三个 jar **不会**出现在 16 个下游组件的 classpath 上 ⇒ 对消费者零影响。
            共享层只在「消费方自己已经带了这些库」时才会真正用到它们：

            · lettuce-core + spring-boot-data-redis —— 为了给 Lettuce 客户端装
              「断连即拒单」（Go 的 fail-open 语义）。
              只有用 Redis 的组件才有这两个 jar ⇒ 同理必须 @ConditionalOnClass 保护。

            ⚠️ 这三个依赖**不能**改成 compile：那会让 16 个组件全部背上
            spring-webmvc / lettuce（其中 6 个 rpc 组件一个都不用）⇒ 违反
            「共享层不得把下游不需要的框架塞给下游」这条纪律。
        -->
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-data-redis</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ============ 5. JSON Canonicalization (RFC 8785 / JCS) ============ -->
        <!--
            对应 Go 版 communityfact/wire.go 的 github.com/cyberphone/json-canonicalization
            用于 CanonicalHash 计算事件摘要
        -->
        <dependency>
            <groupId>io.github.erdtman</groupId>
            <artifactId>java-json-canonicalization</artifactId>
            <version>${java-json-canonicalization.version}</version>
        </dependency>

        <!-- ============ 6. Jackson（替换 Go 版 encoding/json + gin 的 JSON 序列化） ============ -->
        <!--
            对应 Go 版 communityfact/wire.go + response.go：
            - encoding/json → Jackson databind
            - @JsonInclude 注解 → jackson-annotations
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <!-- 版本由 BOM 管理，不再手写 -->
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <!-- 版本由 BOM 管理，不再手写 -->
        </dependency>

        <!-- ============ 测试：JUnit 5 + Mockito + OTEL SDK 测试 util + spring-test（MockHttpServletRequest 等） ============ -->
        <!--
            spring-boot-starter-test：§3.3 要求「凡引入框架机制必须配真正触发该机制的测试」。
            此前 service/common 的 9 个测试类全是纯单元测试（不装配 Spring 上下文），
            所以「Bean 根本没被注册」「@ConfigurationProperties 没绑定」这类缺陷天然测不到 ——
            H1/H2 恰恰就是这两类。
            @SpringBootTest + @EnableConfigurationProperties 才能真正走一遍 binder + Bean 生命周期。
        -->
        <!--
            tomcat-embed-core：**仅测试**（2026-10-25，T-4 / DRIFT-HOTAPI-025 的守门）。

            为什么必须是**真 Tomcat**：本模块要守的机制是「**往 socket 写响应失败**」
            （客户端断连 ⇒ Tomcat 抛 ClientAbortException）。
            MockHttpServletResponse / MockMvc 的 write() **永远不失败**
            ⇒ 断连分支**根本触发不了** ⇒ 那种测试是「错误答案的守卫」（§3.3）。

            ⚠️ **刻意不写 version**：交给 spring-boot-dependencies 管 ⇒ 与各 api 模块运行时
            用的 Tomcat 是**同一个版本**（写死版本号 = 在同一条 classpath 上塞第二个 Tomcat）。
            ⚠️ 排除 tomcat-annotations-api：与 spring-boot-starter-tomcat-runtime 的做法一致
            （Boot 用 jakarta.annotation:jakarta.annotation-api 顶替它）⇒ 离线仓库里
            没有 tomcat-annotations-api，不排除会直接解析失败。
            ⚠️ tomcat-embed-core **自带 jakarta.servlet API**（与本模块 provided 的
            jakarta.servlet-api 同为 Servlet 6.1 规格）⇒ 测试期两份共存，
            取 classpath 上先命中的那份即可，不影响判定（真 Tomcat 用的就是它自己那份）。
        -->
        <!--
            tomcat-embed-core（**optional 编译期**）：
            GoStyleTomcatParameterLimitCustomizer 的 lambda 参数类型就是
            org.apache.catalina.connector.Connector ⇒ javac 必须在**编译期**看到它。

            ⚠️ 为什么是 optional（而不是 compile / test）：
              · optional 依赖**不传递** ⇒ 只有 service/common 自己能看到它；
                运行时「有没有 Tomcat」取决于宿主应用：
                  · api 模块 ⇒ spring-boot-starter-web ⇒ starter-tomcat ⇒ tomcat-embed-core ✅
                  · rpc 模块 ⇒ 没有 ⇒ 该 Bean 由 @ConditionalOnClass(name=...) 挡掉 ✅
              · 若写成非 optional ⇒ 10 个 rpc 模块的 classpath 上会平白多一个 Tomcat 运行时。
            ⚠️ 历史上这里是 test 作用域；2026-10-25 因上面那条共享层修复而升到 optional 编译期。
        -->
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
            <optional>true</optional>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.tomcat</groupId>
                    <artifactId>tomcat-annotations-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--
            spring-boot-tomcat（optional 编译期）：
            GoStyleTomcatParameterLimitCustomizer 需要引用
            org.springframework.boot.tomcat.ConfigurableTomcatWebServerFactory
            （Boot 4 把 Tomcat 支持从 spring-boot-autoconfigure 拆到了独立模块）。

            ⚠️ 为什么是 optional：
              optional 依赖**不传递** ⇒ 只有 service/common 自己能在编译期看到它；
              运行时「有没有它」取决于宿主应用：
                · api 模块 ⇒ spring-boot-starter-web ⇒ spring-boot-starter-tomcat ⇒ spring-boot-tomcat ✅
                · rpc 模块 ⇒ 没有 ⇒ 该 Bean 由 @ConditionalOnClass(name=...) 挡掉 ✅
            ⇒ 绝不能让它变成非 optional ⇒ 否则 10 个 rpc 模块的 classpath 上会多一个 Tomcat 运行时。

            ⚠️ 不写 version：交给 spring-boot-dependencies BOM 管 ⇒ 与各 api 模块用的是同一个版本。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-tomcat</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
            spring-boot-starter-web（**仅测试**）：
            守门测试需要跑一个**真 Spring Boot 容器**（@SpringBootTest + RANDOM_PORT），
            才能证明「GoStyleTomcatParameterLimitCustomizer 这个 Bean 真的被 Boot 应用到了 connector 上」
            —— AGENTS.md §3.3：「注解存在 / Bean 存在」≠「机制生效」。

            ⚠️ test 作用域 ⇒ 不会传递给任何下游模块。
            ⚠️ 它顺带带来 spring-boot-starter-tomcat ⇒ 与上面那条 optional 编译依赖**同版本**（BOM 管）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            ⚠️ jakarta.annotation-api **不在这里声明**：它已经由 spring-boot-starter（compile 作用域）
            传递进来（ObservabilityLifecycle 的 @PreDestroy 就用它）。
            ⚠️ 本轮曾把它显式声明成 test 作用域 ⇒ Maven「最近者优先」把它顶掉了
            ⇒ **compile classpath 上 jakarta.annotation 消失** ⇒ ObservabilityLifecycle 编译失败
            （教训：加 test 作用域依赖前先确认它没有以更近的路径提供同名 artifact）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            grpc-core：**仅测试**。主源码只需要 grpc-api（grpc-stub 已带），
            但 GoStyleRequestDeadlineTest 要用 io.grpc.inprocess.InProcessServerBuilder
            起一个「故意挂住」的真 gRPC server，才能证明 deadline 真的中断了调用。
            scope=test ⇒ 不会传递给任何下游模块。
        -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            🔴 2026-10-25（第二十一轮 · global T-11）：grpc-netty-shaded —— **仅测试**。
            用途：守门要起一个**真的** OTLP/gRPC 接收端（假 jaeger），证明
            「span 真的被导出到网络上」而不是「exporter 被配上了」（§3.3：注解/配置存在 ≠ 机制生效）。
            为什么是 netty-shaded：OTLP/gRPC 的 **客户端**由 opentelemetry-exporter-otlp
            内部的 OkHttp 传输承担，服务端用 grpc-netty-shaded 起 ⇒ 两侧都是 HTTP/2 + gRPC 帧。
            ⚠️ 版本**不写**：由根 pom 的 grpc-bom（${grpc.version} = 1.63.0）管。
            scope=test ⇒ 不会传递给任何下游模块。
        -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <!--
                ⚠️ **刻意不写 version**，交给 spring-boot-dependencies 管理（= 7.0.9）。
                2026-10-25 订正：本条原先写死 7.0.0，是**既有技术债**，本次一并修掉。
                起因：spring-test 7.0.0 与同 classpath 上的 spring-webmvc 7.0.9 组合 ⇒
                  ObservabilityWiringTest 加载时 NoClassDefFoundError:
                  org/springframework/web/accept/ApiVersionHolder
                  （该类 7.0.0 里没有、7.0.9 才有；spring-webmvc 7.0.9 依赖它）。
                ⚠️ 为什么必须是「同一个 Spring Framework 版本」：
                  写死版本 = 在同一条 classpath 上塞第二个 Spring Framework 版本 ⇒
                  同名不同类 ⇒ @ConditionalOnWebApplication / WebMvcConfigurer 等类型
                  出现「同名不同类」，装配结果不可预测（§3.3 同款：不报错的失效）。
                本条是 test 作用域 ⇒ 不传递给任何下游模块 ⇒ 改动影响面仅限 service/common 自身。
            -->
            <scope>test</scope>
        </dependency>
        <!--
            spring-web：H5 修复需要 RequestContextHolder。
            为什么是 optional 而不是普通 compile：
              RequestContextHolder 是 Spring Web 把「当前请求」存进 ThreadLocal 的入口，
              超时分支把 chain.doFilter 换到 worker 线程后必须手工搬运它，否则整条 Spring Web 链
              （@RequestScope / LocaleContextHolder / 未来引入的 SecurityContextHolder）在 worker 上全空。
            为什么必须 optional：
              service/common 同时被纯 gRPC 进程（user-rpc / admin-rpc）依赖。若用普通 compile，
              spring-web 会沿 Maven 传递进那些模块 —— 那正是 §6.3 定案里
              「com.rag.common 不能进 scanBasePackages，否则纯 gRPC 进程被拖进 web 类」的同一个坑。
              optional=true 表示：service/common 自己能编译，但不传递给下游。
            运行期安全性：RequestContextHolder 只在 HttpMiddleware 的超时分支被引用；
              纯 gRPC 进程不注册 HttpMiddlewareFilter → 不加载 HttpMiddleware → 该类引用不会被解析。
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <!--
                ⚠️ **刻意不写 version**，交给 spring-boot-dependencies 管理（= 7.0.9）。
                2026-10-25 订正：本条原先写死 7.0.0，是**既有技术债**，本次一并修掉。
                起因：直接声明优先 ⇒ classpath 上 spring-web 7.0.0 压过 starter-web 带来的 7.0.9，
                  而 spring-webmvc 7.0.9 需要 spring-web 7.0.9 的
                  org.springframework.web.accept.ApiVersionHolder（7.0.0 里没有）
                  ⇒ NoClassDefFoundError。
                ⚠️ 为什么必须与 spring-webmvc / spring-test 同版本：
                  写死版本 = 同一条 classpath 上两个 Spring Framework 版本 ⇒
                  同名不同类 ⇒ 装配结果不可预测（§3.3 同款：不报错的失效）。
                ⚠️ 影响面：optional=true ⇒ 不传递给下游 ⇒ 仅 service/common 自身 classpath 变化。
            -->
            <optional>true</optional>
        </dependency>
        <!--
            spring-webmvc：**Go 风格请求体判据**（com.rag.common.http.GoStyleJsonBodyConverter）需要
            org.springframework.http.converter.json.JacksonJsonHttpMessageConverter。
            为什么必须 optional（与上面 spring-web 同理，但对纯 gRPC 进程更致命）：
              本类继承 Jackson 转换器，class 签名直接引用 spring-webmvc 的类型。
              若非 optional，它会沿 Maven 传递给只需要一张错误码表的纯库模块，
              而那些模块的运行期**没有 servlet / 没有 MVC**，一旦该类被加载就是 NoClassDefFoundError。
            运行期安全性：GoStyleJsonBodyConverterConfig 只在 servlet web 进程里生效
            （它是 WebMvcConfigurer，Web MVC 栈不装配它就不会被实例化）。
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <!--
                ⚠️ **刻意不写 version**，交给 spring-boot-dependencies 管理。
                理由：本仓库离线（-o）可用的是 7.0.5 / 7.0.9，写死 7.0.0 会直接解析失败；
                更要命的是写死版本等于**在同一个 classpath 上引入第二个 Spring Framework 版本** ——
                那会让 @ConditionalOnWebApplication、WebMvcConfigurer 等类型出现「同名不同类」，
                装配结果不可预测（§3.3 同款：不报错的失效）。
                （旁边那条 spring-web 也已于 2026-10-25 一并去掉硬编码 —— 它原先写死 7.0.0，
                  会压过 starter-web 带来的 7.0.9 ⇒ spring-webmvc 7.0.9 找不到
                  ApiVersionHolder ⇒ NoClassDefFoundError。三条现在统一由 BOM 管。）
            -->
            <optional>true</optional>
        </dependency>
        <!--
            Jackson 3（tools.jackson.core:jackson-databind）：编译期需要，
            因为 GoStyleJsonBodyConverter 的父类 JacksonJsonHttpMessageConverter 的
            构造器签名里就是 tools.jackson.databind.json.JsonMapper。
            ⚠️ 本模块同时还声明了 Jackson 2（jackson-databind，communityfact 在用）——
            两代并存是既有事实，本次只把 Jackson 3 以 optional 补进来，**不删不改** Jackson 2。
            ⚠️ 同样是 optional：只需要一张错误码表的纯库模块不需要 Jackson 3。
            运行期安全性：本类的实例只在 servlet web 进程里由 WebMvcConfigurer 创建。
        -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- ============ 3c. MyBatis-Plus（**仅 test 作用域** · 2026-10-27 新增）============ -->
        <!--
            用途：让本模块的守门能证明「**MyBatis-Plus 自动收集容器内的 `Interceptor[]` Bean**」
            这条机制**真的生效**（AGENTS.md §3.3：注解存在 ≠ 机制生效 ⇒ 必须有运行证据）。

            ⚠️ **为什么 scope 必须是 test（而不是 3b 段明令禁止的 compile）**：
            3b 段禁止 mybatis-plus-boot-starter 的理由是「starter 会带 MybatisPlusAutoConfiguration，
            把所有依赖本模块的服务（含纯 gRPC 进程与无数据源的 api 模块）都拖进自动配置扫描范围」。
            而 **test 作用域不传递给下游**（Maven 语义：test 依赖不可传递）
            ⇒ ⇒ 下游 16 个组件的编译期与运行期 classpath **完全不受影响**
            ⇒ ⇒ 3b 段的顾虑**在 test 作用域下不成立** ⇒ 这正是把这条机制钉死在共享层的唯一可行落点
            （写在某个域的 rpc 模块里 ⇒ 就变成「那个域的证据」，不是「全仓的证据」）。

            ⚠️ **版本必须与生产一致**：mybatis-plus 由根 pom 的 `mybatis-plus-bom`（3.5.17）管、
            mybatis 本体由根 pom 显式锁 3.5.19 ⇒ ⇒ 本模块的测试解析到的
            **与 10 个 rpc 组件运行时解析到的完全一致** ⇒ ⇒ 不会出现「同一个 Executor 接口被加载两份、
            拦截器的 type/signature 匹配静默失效」（3b 段的告诫）。

            ⚠️ **实测前提（javap，2026-10-27）**：MP 3.5.17 的 `MybatisPlusAutoConfiguration`
            构造器收 `ObjectProvider<org.apache.ibatis.plugin.Interceptor[]>` ⇒ ⇒ 它**确实**会把容器内
            全部 `Interceptor` Bean 收集起来交给 `SqlSessionFactoryBean.setPlugins(...)`。
            ⚠️ 该类在 **3.5.17 里位于 `mybatis-plus-spring-boot3-starter` jar 内**（不在 autoconfigure jar），
            且 **3.5.5 与 3.5.17 的包结构不同** ⇒ ⇒ 结论必须在**项目实际使用的版本**上验证，不能拿旧版推。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 真 PostgreSQL（守门要真 PG，不是 H2 替身）—— 版本由 spring-boot-starter-parent 的 BOM 管 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <!--
                关掉 Ryuk：Testcontainers 2.x 的 ResourceReaper 读的是**环境变量**
                System.getenv("TESTCONTAINERS_RYUK_DISABLED")，testcontainers.properties 与 -D 无效，
                只有 surefire 注入 env 才有效（同 message-rpc / like-rpc / article-rpc 的实测结论）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
                    </environmentVariables>
                    <!--
                        🔴 本模块的 test classpath 上**有** pgjdbc 驱动（单 1 的真 PG 守门需要它）
                        ⇒ ⇒ `DataSourceAutoConfiguration` 会**被激活**
                        ⇒ ⇒ 而本模块里另有 7 个用 `@EnableAutoConfiguration` 的测试上下文
                        （真 Tomcat 守门 / 观测装配守门 等）**并不配数据源**
                        ⇒ ⇒ 上下文启动时就会炸：
                        「Failed to configure a DataSource: 'url' attribute is not specified」。

                        ⚠️ **这不是新缺陷，是单 1 引入 test scope 驱动后的连带效应**
                        ⇒ 这里用两个系统属性把它压掉（**只作用于本模块的测试**，
                        对 16 个下游组件零影响 —— test scope 不传递）：

                        ① `spring.datasource.url` —— 给一个**必然连不上**的地址：
                           只为让自动配置**有 url 可读**，不代表真有人会连它；
                        ② `spring.datasource.hikari.initialization-fail-timeout=-1`
                           —— Hikari 的默认值是 1ms（**fail fast**）⇒ 启动即校验连接
                           ⇒ 连不上就直接把上下文打挂；-1 = **启动时不去校验连接**
                           ⇒ ⇒ 不碰数据库的测试上下文可以正常起来。

                        ⚠️ 需要真 PG 的那条守门（`MybatisPlusInterceptorChainGateTest`）
                        用 `@DynamicPropertySource` 指向 testcontainers 起的真容器
                        ⇒ `@DynamicPropertySource` 的优先级**高于**系统属性 ⇒ 它不受这两条影响。
                    -->
                    <systemPropertyVariables>
                        <spring.datasource.url>jdbc:postgresql://127.0.0.1:1/none</spring.datasource.url>
                        <spring.datasource.hikari.initialization-fail-timeout>-1</spring.datasource.hikari.initialization-fail-timeout>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>