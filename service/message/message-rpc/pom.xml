<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2000/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId>
        <artifactId>message</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>message-rpc</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- ============== 1. 内部模块依赖 ============== -->
        <!--
            message-proto：MessageServiceGrpc（server ImplBase + client Stub）由本模块直接引用。
            HUMAN_ONLY.MD 强约束：
              - @TableName("message_*") 取代 GORM @gorm tag
              - Mapper extends BaseMapper<Entity> 取代 Hibernate EntityManager
              - Flyway V*__create_*.sql 取代 GORM AutoMigrate
              - 9 个 Logic 合并为 1 个 MessageDomainService（grpc-java 框架约束），
                server 入口为 1 个 MessageRpcServiceImpl thin wrapper。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>message-proto</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
            user-proto：UserServiceBlockingStub（Facade 调用，校验 user 域 ID）。
            admin-proto：AdminServiceBlockingStub（Facade 调用，校验 admin 域 ID + GetUserList 广播）。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>user-proto</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>admin-proto</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
            message-common：MessageErrorCode / MessageErrorMessages / MessageGrpcError。
            业务错误码 + gRPC code ↔ biz code 双向转换在 message-common 完成（带 focused tests）。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>message-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
            service/common（artifactId=common）：服务级共享
            LoggerFactoryBean / SnowflakeBean / OpenTelemetry Tracer / observability。
            Go 端 snowflake.GetID 对应 SnowflakeBean.nextId。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <!-- ============== 2. Spring Boot 基础（gRPC server 无 web） ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
            spring-cloud-starter-alibaba-nacos-discovery 通过反射引用
            org.springframework.boot.web.server.context.WebServerInitializedEvent。
            message-rpc 不引 spring-boot-starter-web，但 spring-boot-web-server 含这个类 + 抽象接口。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-web-server</artifactId>
        </dependency>

        <!-- ============== 3. gRPC server + client ============== -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-core</artifactId>
        </dependency>
        <!-- @GrpcService 自动起 gRPC server（替代 zrpc.MustNewServer） -->
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-server-spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--
            @GrpcClient("user-rpc") / @GrpcClient("admin-rpc") 用：自动发现 + channel pool
            （替代 Go 端 zrpc.MustNewClient + userservice.NewUserService(...)）
        -->
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-client-spring-boot-starter</artifactId>
            <version>3.1.0.RELEASE</version>
            <exclusions>
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ============== 4. 数据访问：Postgres + MyBatis-Plus + Flyway ============== -->
        <!--
            对应 Go 端 Postgres.* 配置 + GORM 模型
            HUMAN_ONLY.MD 强制 MyBatis-Plus 取代 JPA：
              - @TableName("message_*") + @TableId 取代 @Entity/@Table + @Id
              - Mapper extends BaseMapper<Entity> 取代 EntityManager.createQuery
              - Flyway V*__create_*.sql 取代 Hibernate ddl-auto: update
            ⚠️ strict HUMAN_ONLY 偏离 Go GORM 默认：表名 message_* 与 Go 同
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
            ⚠️ spring-boot-flyway 是必需的（2026-10-22 补，DRIFT-MSG-006）。

            Spring Boot 4 把自动配置拆成了「按技术分模块」的形式：
            flyway-core 只是 Flyway 引擎本身，**不提供任何 Spring 自动配置**；
            真正让 `spring.flyway.*` 生效、并在启动期执行 `classpath:db/migration` 迁移的
            是 `org.springframework.boot:spring-boot-flyway`（Boot 4 新增的独立模块）。

            缺它时的表现极具欺骗性——**启动日志里连一行 Flyway 都没有**（不是报错，是根本没被加载），
            迁移脚本永远不执行 ⇒ 三张 message_* 表永不创建 ⇒
            第一次真正执行 SQL 时才炸：
                org.postgresql.util.PSQLException: ERROR: relation "message_conversation_message" does not exist
            而本模块此前**没有任何 @SpringBootTest、也没进 difftest**，
            ⇒ 「迁移到底跑没跑」这件事从来没被验证过。

            Boot 3 时代 flyway-core 由 spring-boot-autoconfigure 顺带提供自动配置，
            Boot 4 起必须显式引本模块。版本由 spring-boot-starter-parent 的
            dependencyManagement 管理，不要写 version。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- ============== 5. Metrics：Micrometer + Prometheus ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- ============== 6. 测试 ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Testcontainers（版本由 spring-boot-starter-parent 的 testcontainers.version 管理，不写 version）。
            为什么事务 wiring 测试必须是真 PostgreSQL、不能用 H2：
              - message_conversation_message 有 2 个复合索引 + message_conversation 有 4 列唯一索引
                （uk_conversation_pair），H2 与 PG 的唯一约束行为不同，
                而「唯一约束冲突必须整事务回滚」正是本模块要验证的不变量（DRIFT-MSG-001）；
              - jsonb 列（Notification.extra）走 JacksonTypeHandler → ps.setObject(..., Types.OTHER)；
              - Flyway 的 3 份迁移脚本面向 PG 写的。
            替换成 H2 等于把要验证的东西换没了。对应 AGENTS.md §6.6.4 的证据边界台账：
            本模块此前零集成测试，正是 DRIFT-001/002/003 能同时存在而 CI 全绿的根因。
            同款依赖与理由见 service/users/admin/admin-rpc/pom.xml。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ============== 7. OpenTelemetry OTLP exporter ============== -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- ============== 8. Nacos service discovery ============== -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- ============== 9. JSONB 字段支持（Notification.extra 列 PG 类型 jsonb） ============== -->
        <!--
            对应 Go 端 JSONMap 自定义 driver.Valuer / sql.Scanner。
            Java 端用 MyBatis-Plus 内置 Jackson TypeHandler（Map<String,String> ↔ PGobject(jsonb））。
            具体见 NotificationMapper 的 typeHandler 配置 / NotificationEntity extra 字段注解。
        -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                集成测试必须关掉 Ryuk，否则在本机/CI 上起不了任何容器。

                原因（实测，非推测，与 admin-rpc / user-rpc 同款）：
                  1. Testcontainers 2.x 的 ResourceReaper.instance() 读的是
                     **环境变量** System.getenv("TESTCONTAINERS_RYUK_DISABLED")，
                     字节码里就一句 getenv —— testcontainers.properties 与 -D 都无效，
                     只有 surefire 注入 env 才有效。
                  2. Ryuk 镜像 testcontainers/ryuk:0.14.0 需要从 Docker Hub 拉，
                     本机走镜像加速器拉 Docker Hub 会 EOF 失败，
                     表现为 "Can't get Docker image: RemoteDockerImage(ryuk:0.14.0)"，
                     且发生在 @Container 之前 —— 整个类直接 ContainerFetch 失败。

                关掉后的行为：改用 JVMHookResourceReaper（纯 JVM shutdown hook，不起容器）。
                代价 = 容器不再自动回收，CI 跑完可能残留。测试用的 postgres:16-alpine
                镜像需在本地已有（或换可达镜像源）。

                恢复方式：删掉下面这段；Ryuk 会自动启用（前提是 Docker Hub 可达）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>