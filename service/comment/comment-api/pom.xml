<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId>
        <artifactId>comment</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>comment-api</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- ============== 1. 内部模块依赖 ============== -->
        <!--
            comment-proto：CommentServiceGrpc client Stub。
            对应 Go 端 service/comment/api/internal/svc/servicecontext.go 的 CommentCli 字段：
                CommentCli: commentpb.NewCommentServiceClient(conn.Conn())
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>comment-proto</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
            comment-common：CommentErrorCode / CommentErrorMessages / CommentCodeError。
            对应 Go 端 service/comment/common/errmsg/errmsg.go。
            ⚠️ 本模块**不使用** CommentGrpcError.bizCodeFromError —— Go 侧 7 个 logic 里
               零命中该函数（逐条核对，见各 Service 的 rpcError javadoc）。理由见 CommentApiSupport#rpcError。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>comment-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
            users-common：只依赖 3 个**静态工具类**，不引入其 Bean。
              - JwtUtil.padToHmacKeySize   （jjwt 强制 HMAC key ≥ 32 字节）
              - BearerTokenExtractor      （golang-jwt 的 Bearer 前缀剥离规则）
              - GoStyleCoercion           （Jackson 3 标量强转共享规则）
            ⚠️ 与 message-api 同款约束：scanBasePackages 刻意**不含** com.rag.users，
               避免把 SchemaInitializer 拖进本模块上下文。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>users-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
            service/common（artifactId=common）：Response envelope + BusinessException /
            AuthenticationException + FatalError + GoStyleRouterErrorResponses +
            GoStyleCircuitOpenException + HttpMiddlewareFilter + GoStyleRequestDeadline。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <!-- ============== 2. Spring Boot Web（HTTP server） ============== -->
        <!-- 对应 Go 端 rest.MustNewServer(c.RestConf) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ============== 3. Observability（Go Telemetry.* + HttpMiddleware） ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- ============== 4. JWT 验签（jjwt 0.12.6，版本由根 pom 管理） ============== -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ============== 5. gRPC client（连 comment-rpc） ============== -->
        <!--
            与 message-api / user-api 同款：devh 3.1.0.RELEASE。
            ⚠️ 必须 exclude io.grpc:grpc-core（devh 默认拖 1.63.0），版本统一由根 pom 管。
            ⚠️ 必须显式写 negotiation-type: plaintext（DRIFT-NEW-014 同款）：
               devh 的 GrpcChannelProperties 默认值是 TLS，而 comment-rpc 是明文 gRPC
               （Go 侧 zrpc.MustNewServer 无 TLS）。
        -->
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-client-spring-boot-starter</artifactId>
            <version>${grpc-spring-boot-starter.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-core</artifactId>
        </dependency>

        <!-- ============== 6. Nacos 服务发现 ============== -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- ============== 7. 测试 ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Boot 4 把测试切片拆成独立 artifact：@AutoConfigureMockMvc 在
            org.springframework.boot.webmvc.test.autoconfigure，不再在
            spring-boot-test-autoconfigure 里。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            真 in-process gRPC server + 真 channel：
            验证 comment-rpc 的业务码（自定义 trailer `rag-comment-biz-code`）
            **真的能穿过传输层**抵达 api 侧，并被 CommentApiSupport.rpcError 还原成
            envelope.code。
            ⚠️ 只断言 `CommentGrpcError.grpcError(...).getTrailers()` 的值**证明不了**它
               穿过了传输层 —— 本仓此前已多次栽在「单测全绿但真实链路上没生效」上
               （AGENTS.md §3.3）。同款写法见 like-common/LikeGrpcErrorTest.java。

            🔴🔴 **刻意不在这里声明 grpc-inprocess**（2026-10-24 双侧活体对拍时踩过）：
            本仓所有 api 模块的 grpc-inprocess 都来自
            `net.devh:grpc-client-spring-boot-starter:3.1.0.RELEASE` 的**传递依赖**
            （compile 作用域）—— devh 的 `GrpcClientAutoConfiguration` 在**运行期**
            就要 `io.grpc.inprocess.InProcessChannelBuilder`。

            ⚠️ **Maven「最近者优先」是这里的关键陷阱**：
            一旦在本模块**直接**声明 `io.grpc:grpc-inprocess` 并标成 `<scope>test</scope>`，
            它（深度 1）就会**顶掉** devh 传递过来的那份（深度 2、compile 作用域）
            ⇒ **运行时 classpath 里就没有 grpc-inprocess 了**
            ⇒ 启动期报 `NoClassDefFoundError: io/grpc/inprocess/InProcessChannelBuilder`
            （抛点：`GrpcClientAutoConfiguration#shadedNettyGrpcChannelFactory`）
            ⇒ **组件根本起不来**，而单元测试全绿。

            ⇒ 本模块**不需要**自己声明：devh 的传递依赖已经同时满足
            「测试要 in-process server」与「运行期要 InProcessChannelBuilder」两个需求。
        -->
    </dependencies>

    <!-- ============== 8. 构建 ==============
         ⚠️ 缺 <build> ⇒ 没有 spring-boot-maven-plugin 的 repackage ⇒ 产物是普通 library jar，
            `java -jar` 报「中没有主清单属性」（守门脚本 tools/difftest/check-jar-executable.sh）。
    -->
    <build>
        <plugins>
            <!-- 启动类 CommentApiApplication 靠 spring-boot-maven-plugin 打成可执行 jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>