<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId>
        <artifactId>hot</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>hot-rpc</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- ============== 1. 内部模块依赖 ============== -->
        <!--
            hot-proto：HotServiceGrpc base + 5 个方法的服务端 Stub
            （对应 Go 端 rpc/pb/hot_grpc.pb.go + rpc/internal/server/hot_service_server.go）。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>hot-proto</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
            common（artifactId=common）：服务级共享能力，对应 Go 端 service/common/*：
              - logger.Logger / LoggerFactoryBean        ← Go common/logger（hot.go:47 的 logger.Init("hot.rpc")）
              - spring.RpcServerInterceptorFactory         ← Go observability.NewUnaryServerInterceptor（2s deadline）
              - observability.MqConsumer                   ← Go observability.TraceConsumer（hot_handler.go:105）
            ⚠️ 依赖本模块不等于 scanBasePackages 自动含 com.rag.common：
               HotRpcApplication 必须显式写 scanBasePackages = "com.rag.common"
               或用 @Import 显式引 RpcServerInterceptorFactory（AGENTS.md §3.3 记录的装配陷阱：
               @Component 不等于自动注册）。

            ⚠️ **刻意不依赖 hot-common** —— service/hot/common/errmsg.go 经 grep 验证在
               rpc/ 下**零引用**，本模块 3 个互动方法返回的是 gRPC UNIMPLEMENTED status 而非业务码，
               不需要任何错误码常量类。依据 FileTree/hot/common.md §12.5 判据 2
               （不给死代码建结构；like-rpc 的 258 行 LikeGrpcError 是反面样本）。
               ✅ 这条「依赖了但不用」的取舍已定（2026-10-22）：码表落进 hot-common，
               而本模块**刻意不声明**对它的依赖 ⇒ 「依赖了但不用」并不成立，本段无需改动。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <!-- ============== 2. Spring Boot 基础（纯 gRPC，不带 web） ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
            spring-boot-web-server：只为满足 nacos-discovery 的反射引用
            （org.springframework.boot.web.server.context.WebServerInitializedEvent）。
            不引它启动不了 Nacos 自动配置，但**不会**因此起 web 容器 —— 本服务无 WebApplicationType。
            与 message-rpc / like-rpc 完全同款。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-web-server</artifactId>
        </dependency>

        <!-- ============== 3. Redis（对应 Go 端 *redis.Redis） ============== -->
        <!--
            ★ Go 侧 svc.ServiceContext.Redis，唯一的 keyspace 是热度榜：
              - hot:articles        ZSet，GetHotArticles 的读取源
              - hot:articles:p{i}   分区快照
              - …:shadow            合并期的影子榜
              - hot:merge:lock      合并分布式锁
              - 4 段 Lua（对应 hot_handler.go 的 Redis 快照段）

            ⚠️ 错误语义是真正的缺口，见 HotRedisSnapshotStore 的类注释：
               Go 的同步失败只 log + return（不抛），而 Spring Data Redis 一律抛异常。
               必须显式吞掉，否则会把 Go 的「快照失败不影响主流程」变成「消费失败触发重试」。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
            ⚠️ commons-pool2 **不可省**（2026-10-27 G3 · Redis 连接池形态对齐）：
               本模块的 application.yml 配了
               `spring.data.redis.lettuce.pool.enabled: true`
               ⇒ Boot 4 的 `DataRedisConnectionConfiguration#isPoolEnabled`（`:195-198`，实测字节码）：
                  `Boolean enabled = pool.getEnabled(); return (enabled != null) ? enabled : COMMONS_POOL2_AVAILABLE;`
               ⇒ 显式配了 true 就走 `LettuceConnectionConfiguration#createBuilder` 的 `PoolBuilderFactory`
               ⇒ **该分支会构造 `org.apache.commons.pool2.impl.GenericObjectPoolConfig`**
               ⇒ 而 **Boot 4 的 starter 不再传递 commons-pool2** ⇒ 缺它 ⇒ **启动期直接失败**
                  （`NoClassDefFoundError: org/apache/commons/pool2/impl/GenericObjectPoolConfig`）。
               ⚠️ 实测（本轮 · 2026-10-27）：`spring-boot-starter-data-redis:4.0.8` 的 pom 里
                  只有 `spring-boot-starter` + `spring-boot-data-redis`；
                  `spring-boot-data-redis:4.0.8` 的 pom 里也**没有** commons-pool2（只有 `lettuce-core`）
                  ⇒ ⇒ commons-pool2 **只能由应用自己声明**，无任何传递来源。
               ⚠️ 同款事故已有本仓实证：like-rpc 2026-10-23 缺它时启动报同一个 NoClassDefFoundError。
               ⇒ Go 出处（形态对齐的依据 · **消费点**）：
                  真源 `service/hot/rpc/internal/svc/service_context.go:17-20`
                     `redis.NewClient(&redis.Options{Addr: c.RedisConf.Host, Password: c.RedisConf.Pass})`
                  ⇒ **只设 2 个字段** ⇒ `PoolSize` 未设 ⇒ 落 go-redis v9.20.0 库默认
                     （`go-redis@v9.20.0/options.go:350-351` `PoolSize = 10 * runtime.GOMAXPROCS(0)`）
                  ⇒ ⇒ **Go 侧是有池的**
                  ⇒ RAG 侧若无池 ⇒ Lettuce 走**共享单连接** ⇒ 并发下命令互相串行排队
                  ⇒ ⇒ **形态漂移**（不是数值漂移）⇒ 池大小按数量级对齐（Go 是 10×核数，机器相关）。
               ⚠️ 版本由 spring-boot-dependencies BOM 管理 ⇒ **不写 <version>**。
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- ============== 4. Kafka（对应 Go go-queue / sarama ConsumerGroupHandler） ============== -->
        <!--
            ★ Go 侧 rpc/internal/mqs/hot_handler.go 是 sarama ConsumerGroupHandler：
              - topic=article-hot-events，group=article-hot-group，3 个分区对应 3 个实例副本
              - rebalance 时把该分区的 sketch 落盘 Redis，重新获得分区时从 Redis 回灌

            Spring 侧对应：@KafkaListener（HotEventConsumer）+ partition assign/revoke 回调
            （HotPartitionSketchRegistry）。ack 模式 / 并发度 / 重试策略都是必须显式声明的
            独立关注点 —— 见 FileTree/hot/rpc.md §12.5「新增包说明」mq/。
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!--
            ⚠️ Spring Boot 4 把 Kafka 自动配置整体搬出了 spring-boot-autoconfigure，
               改由独立模块 spring-boot-kafka 提供（实测 autoconfigure-4.0.8.jar 内
               Kafka 类数量为 0；KafkaAutoConfiguration / ConcurrentKafkaListenerContainerFactoryConfigurer
               都在 spring-boot-kafka 里）。
               只引 spring-kafka ⇒ **没有 ConsumerFactory Bean、没有 @KafkaListener 后置处理器**，
               @KafkaListener 会被完全静默忽略，且启动不报错。
               版本由 spring-boot-dependencies BOM 管理，不显式写 version。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-kafka</artifactId>
        </dependency>

        <!-- ============== 5. gRPC server ============== -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-core</artifactId>
        </dependency>
        <!-- @GrpcService 自动起 gRPC server（替代 zrpc.MustNewServer） -->
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-server-spring-boot-starter</artifactId>
            <version>${grpc-spring-boot-starter.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--
            ⚠️ 刻意不引 grpc-client-spring-boot-starter：Go 侧 hot-rpc **零下游 gRPC 客户端**
               （FileTree/hot/rpc.md §12.5「不建 client/」）。引入会多一条永远不用的通道。
            ⚠️ Go 侧存在 client 熔断（zrpc/internal/config.go:14 default=true），
               但那作用于下游调用；本模块无下游调用 ⇒ 无需对应拦截器。
        -->

        <!-- ============== 6. Nacos 服务发现（替代 Go etcd 注册） ============== -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- ============== 7. Metrics：复刻 Go 端 hot_* metric ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!--
            🔴 spring-boot-starter-web：**只为给 Actuator 一个 servlet 载体**
            ⇒ 让 `management.endpoints.web.exposure.include: prometheus` 真正有出口。

            【Go 出处（真源 · 消费点）】—— hot 域走的是 **Prometheus 块**（不是 DevServer）
              service/hot/rpc/etc/hot.yaml:8-11
                  Prometheus: {Host: 0.0.0.0, Port: 19091, Path: /metrics}
              ⇒ go-zero 的 zrpc.RpcServerConf **内嵌** service.ServiceConf
                 （go-zero@v1.10.2/zrpc/config.go:39）
              ⇒ ServiceConf.Prometheus 字段（go-zero@v1.10.2/core/service/serviceconf.go:38）
              ⇒ ⇒ 消费点 zrpc/server.go:63 `c.SetUp()`
                 ⇒ ⇒ core/service/serviceconf.go:62 `prometheus.StartAgent(sc.Prometheus)`
                 ⇒ ⇒ core/prometheus/agent.go:31（Host 为空 ⇒ 直接 return，不启动）
                 ⇒ ⇒ core/prometheus/agent.go:38 `http.Handle(c.Path, promhttp.Handler())`
                 ⇒ ⇒ core/prometheus/agent.go:39-41 **独立端口** `http.ListenAndServe(addr, nil)`
              ⇒ ⇒ Go 侧 hot-rpc **真的**在 0.0.0.0:19091 起了一个 HTTP 服务，路径 /metrics。

            【⚠️ 别被一个「长得像」的文件带偏】
              `service/hot/rpc/internal/metrics/metrics.go` 里也有一段起 metrics HTTP 服务的代码
              （硬编码 `:9091`）⇒ ⚠️ **那是死代码**：`service/hot/rpc/hot.go` 全文**没有**调用它
              ⇒ ⇒ hot-rpc 的观测端口是 **19091**，不是 9091 ⇒ **不得引用那个文件当出处**。

            【为什么以前「有 actuator 却抓不到」】—— AGENTS.md §3.3 的典型形态：
              `spring-boot-starter-actuator` 只提供 **endpoint + 自动配置**，
              **不提供 servlet 容器** ⇒ `management.endpoints.web.*` 这一族配置
              **没有任何载体** ⇒ **配了也不生效**（不是报错，是那一族自动配置根本不加载）。
              ⇒ 且本模块原先还把 management HTTP server **显式关掉**了
                （yml 里 `management.server.port: -1`）⇒ ⇒ 双重关死。

            【Boot 4 拆模块纪律（AGENTS.md §3.3 · 先确认能力还在不在，再决定补哪个模块）】
              - `WebEndpointAutoConfiguration`（actuator 的 servlet web endpoint 映射）
                **仍在** `spring-boot-actuator-autoconfigure` ✔（已在 classpath 上）
              - `PrometheusScrapeEndpoint` + `PrometheusMetricsExportAutoConfiguration`
                在 **`spring-boot-micrometer-metrics`**（`spring-boot-starter-actuator` 传递引入）✔
              ⇒ **唯一缺的就是 servlet 容器 + Spring MVC**
              ⇒ 补 `spring-boot-starter-web`（Boot 4 里它 = starter-tomcat + webmvc + http-converter）
                 **版本由 spring-boot-dependencies BOM 管 ⇒ 不写 `<version>`**。

            【⚠️ 进程形态变了 —— 这是「暴露形态差异」，按 twoStage.md §10 登记】
              Go 侧是 `http.ListenAndServe` 的**小 server**（无 servlet、无业务路由）；
              RAG 侧是 **Tomcat**（有 servlet 容器，但**没有任何业务 HTTP 路由**）。
              ⇒ 两者的**对外可观测面**（独立端口 + Prometheus 文本）一致，载体不同
              ⇒ 登记为暴露形态差异项（与 follow 域 DRIFT-FOLLOW-006 同款）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ============== 8. OpenTelemetry OTLP exporter（Go Telemetry.*） ============== -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- ============== 9. 测试 ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            🔴 真 Redis / 真 Kafka 守门测试（Testcontainers）。

            本组件此前最大的证据缺口就是「4 段 Lua / 两个 TTL / EXISTS 守卫 / RENAME 原子性 /
            RoundRobin 实际分配 / 零重试 handler 只有静态源码证据」（DRIFT/hot/rpc.md UNR-1/2/4/5）。
            这些语义位**无法**用 mock 或手写假 Redis 代替：
              · Lua 里 KEYS[1]/KEYS[2] 绑反 ⇒ 结果 key 写错，不报错；
              · EXPIRE 写死 300 vs 配置 3600 ⇒ 两个 TTL 被"统一"成一个，静态读代码看不出来；
              · RENAME 的原子性是 Redis 单命令保证的；
              · compare-and-EXPIRE / compare-and-DEL 的"值不匹配就不动手"必须真 Redis 才能验；
              · 分区分配策略（RoundRobin vs Range）必须真 Kafka + 多消费者才能观察。

            ⚠️ 与本仓其它域的真 PG 守门测试同口径（见 comment-rpc 的 CommentSchemaPgGateTest）：
               **默认跑、不 skip**。理由是 Go 侧那三个 _test.go 在没有 DSN 时 t.Skip，
               于是"没人验证过"的状态长期存在 —— 静默 skip 会让缺口重新变成缺口。

            版本由 spring-boot-starter-parent 的 testcontainers.version 管理，不写 <version>。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                ⚠️ 必须声明 spring-boot-maven-plugin —— 缺了它就没有 repackage goal
                   ⇒ 打出来的是**普通 library jar** ⇒ `java -jar hot-rpc.jar` 直接报
                   「中没有主清单属性」（no main manifest attribute）⇒ 该模块从来没有被打成过
                   可部署产物。

                修前实测（本工作树，2026-10-26）：
                  service/hot/hot-rpc/target/hot-rpc-0.0.1-SNAPSHOT.jar = 58,873 B
                  MANIFEST.MF 里**零个** Main-Class / Start-Class
                  （对照 article-rpc：104,264,894 B +
                    Main-Class: org.springframework.boot.loader.launch.JarLauncher）

                ⚠️ **不写 <mainClass>** —— 让插件自动探测主类
                   （本模块唯一 main：HotRpcApplication.main，
                    service/hot/hot-rpc/src/main/java/com/rag/hot/hot/rpc/HotRpcApplication.java:111）
                   ⇒ 产物里 Start-Class 会被写成 com.rag.hot.hot.rpc.HotRpcApplication。

                ⚠️ 本插件只对**本模块**生效：service/common 是 library 模块（被 10 个微服务依赖），
                   给它 repackage 会污染下游依赖 ⇒ 不在本模块的修法范围内。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                ⚠️ 显式关掉 Testcontainers 的 Ryuk 资源回收器。

                理由（实测 2026-10-23）：
                  · Ryuk 镜像 testcontainers/ryuk:0.14.0 需要从 Docker Hub 拉；
                  · 本机 Docker Hub 直连不通（registry-1.docker.io 超时），
                    虽然 daemon 配了 3 个镜像加速器，但 TC 自带的 30s 拉取看门狗
                    仍会在「无进度」时直接 abort ⇒ 整轮 IT 挂 4.5 分钟才失败。
                  · 而本模块用到的两个镜像（redis:7-alpine / apache/kafka:3.7.2）
                    **本地已有**，不需要拉。

                关掉 Ryuk 是否安全？
                  · Ryuk 只是「JVM 崩溃后回收孤儿容器」的安全网；
                  · 本模块的容器是 @Container 托管的，由 JUnit 扩展在类结束时
                    显式 stop() ⇒ 正常路径不依赖 Ryuk；
                  · 遗留风险：测试进程被 kill -9 时容器会残留 ⇒ 可用 docker ps
                    配合 label org.testcontainers=true 手工清理。

                ⚠️ 这是**显式取舍**，不是「图省事」：把它写进 pom 是为了让
                   「这个模块的 IT 不需要访问 Docker Hub」这件事**可复现**，
                   而不是依赖某个开发者的 shell 环境变量。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        ⚠️ 必须用**环境变量**而不是 system property：
                        Testcontainers 2.0.5 的 ResourceReaper.instance() 只读
                            System.getenv("TESTCONTAINERS_RYUK_DISABLED")
                        （字节码取证：ResourceReaper.class 的 instance() 方法，
                          ldc "TESTCONTAINERS_RYUK_DISABLED" → System.getenv → Boolean.parseBoolean)
                        ⇒ 写成 <ryuk.disabled>true</ryuk.disabled> 这种 system property
                          **完全无效**（实测：仍然去拉 ryuk 并挂 4.5 分钟后失败）。
                    -->
                    <environmentVariables>
                        <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
                    </environmentVariables>
                </configuration>
                <executions>
                    <!--
                        🔴 产物层守门（DRIFT-HOTRPC-BOOT-001）：绑在 **verify** 阶段。

                        为什么必须是 verify 而不是默认的 test 阶段：
                          · surefire 的默认执行绑在 **test** 阶段，而 **test 阶段跑在 package 之前**
                            ⇒ 那一刻 jar **还不存在** ⇒ 「解包真实产物」这件事在 test 阶段**做不了**。
                          · verify 阶段在 package **之后** ⇒ target/*.jar 已经是 repackage 后的 fat jar
                            ⇒ 才解得出真实的 Main-Class / Start-Class。

                        为什么用 surefire 而不是 maven-failsafe-plugin：
                          · 报告落在 target/surefire-reports/ ⇒ 与本仓其它模块的判定口径一致
                            （PIT-GLOBAL-021：判定只认机器生成的 XML，不认 stdout 的 "in" 行）。

                        ⚠️ 类名带 IT 后缀 ⇒ surefire **默认** includes（**/*Test.java 等）**不匹配**
                          ⇒ 默认执行不会在 test 阶段误捞它（那时它只会 skip）。

                        ⚠️ hot.rpc.gate.phase=verify 让用例知道「本轮 jar 必须存在」
                          ⇒ 找不到 jar 时是**硬失败**而不是 skip（绝不允许假绿）。
                    -->
                    <execution>
                        <id>artifact-gate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/HotRpcFatJarArtifactGateIT.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <hot.rpc.gate.phase>verify</hot.rpc.gate.phase>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
