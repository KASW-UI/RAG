<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId>
        <artifactId>service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <!-- ⚠️ 必须显式指向 service/pom.xml：
             Maven 的默认 relativePath 是 ../pom.xml ⇒ 会指到 service/users/admin/pom.xml
             （坐标是 admin ≠ service）⇒ Maven 判 "parent.relativePath points at wrong local POM"
             ⇒ 回落仓库找 com.rag:service:pom ⇒ 本仓没有制品仓库 ⇒ **干净环境构建必炸**
             （开发机不报错是因为 ~/.m2 里躺着旧的已安装 service pom，把问题掩盖了）。
             ⚠️ 路径必须逐层数对：admin-api 的目录是 service/users/admin/admin-api/ ⇒
               ../pom.xml    = service/users/admin/pom.xml  (artifactId=admin)  ❌ 仍不符
               ../../pom.xml = service/users/pom.xml       (artifactId=users)  ❌ 仍不符
               ../../../pom.xml = service/pom.xml          (artifactId=service) ✅
             这里只改"去哪里找父 POM"，坐标与继承内容都不变 ⇒ 语义等价。
             由 CI（干净 checkout）发现，见 ci/DELIVERY.md §六。 -->
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>admin-api</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- ============== 1. 内部模块依赖 ============== -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>user-proto</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>admin-proto</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>users-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <!-- ============== 2. Spring Boot Web（HTTP server） ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ============== 3. Redis（JWT 黑名单） ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ============== 4. Metrics：复刻 Go 端 admin_api_intercept_total ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- ============== 5. JWT（签发走 users-common/JwtUtil；校验走 jjwt 原生 API） ============== -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ============== 6. gRPC client（连 admin-rpc + user-rpc） ============== -->
        <!--
            与 user-api 同款：devh grpc-client-spring-boot-starter 3.1.0.RELEASE
            提供 @GrpcClient("admin-rpc") / @GrpcClient("user-rpc") 自动注入 BlockingStub
            exclude io.grpc:grpc-core（devh 默认拖 1.63.0，与根 pom grpc.version 1.63.0 同款，可省略但保持一致）
            显式加 io.grpc:grpc-core 由根 pom dependencyManagement 管版本
        -->
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-client-spring-boot-starter</artifactId>
            <version>${grpc-spring-boot-starter.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-core</artifactId>
            <version>${grpc.version}</version>
        </dependency>

        <!-- ============== 7. OpenTelemetry OTLP exporter ============== -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- ============== 8. Nacos service discovery ============== -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- ============== 9. 测试 ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Testcontainers（版本由 spring-boot-starter-parent 管理）。
            admin-api 需要的是 Redis 容器而不是 PG：AdminJwtAuthInterceptor 的黑名单检查
            走 StringRedisTemplate.hasKey，这是 DRIFT-009 的核心机制，
            必须对着真 Redis 验证「黑名单先于验签」的顺序。
            用 GenericContainer（core 自带）即可，无需额外 module。
            对应 AGENTS.md §6.2.3 的 A-U0。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Boot 4 把测试切片拆成了独立 artifact：@AutoConfigureMockMvc 已不在
            spring-boot-test-autoconfigure 里，类也从
            org.springframework.boot.test.autoconfigure.web.servlet
            挪到了 org.springframework.boot.webmvc.test.autoconfigure。
            只引 spring-boot-starter-test 编译不过 —— 实测 m2 里 4.0.8 全部 jar 都没有这个类。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                关掉 Ryuk，理由与 admin-rpc 完全相同：Testcontainers 2.x 的
                ResourceReaper.instance() 只读环境变量 System.getenv("TESTCONTAINERS_RYUK_DISABLED")，
                properties 与 -D 都无效；而 ryuk 镜像走 Docker Hub 拉不下来会导致整类 ContainerFetch。
                代价：容器不再自动回收。Docker Hub 可达后删掉本段即可恢复。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
                    </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
