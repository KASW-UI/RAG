<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.rag</groupId>
        <artifactId>task</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>task-rpc</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- ============== 1. 内部模块依赖 ============== -->
        <!--
            task-proto：TaskServiceGrpc（server ImplBase）。
            proto 源文件逐字复制自 Go 端 proto/task.proto，只多了 java_package / java_multiple_files
            两行（L1 契约：message 名 / 字段号 / 类型一律未改，见 AGENTS.md §3.4）。

            ⚠️ Go 侧 task 域**没有 common 模块**（service/task 下只有 api 与 rpc），
               所以本模块没有 task-common：错误全部是**标准 gRPC code**
               （INVALID_ARGUMENT / UNKNOWN），不需要 like/message 那种业务码 ↔ gRPC code 转换类。
               判定依据：Go get_task_logic.go 只用了 codes.InvalidArgument 与裸 error。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>task-proto</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--
            common（artifactId=common）：observability（MqConsumer.traceConsumer / RpcInterceptor）
            + LoggerFactoryBean + RpcServerInterceptorFactory + Deadline/SQL 超时翻译。
            Go 侧对应 service/common/observability：sinks 的每次 Consume / flush 都被
            observability.TraceConsumer 包了一层，Java 侧必须同样包，否则 span 全丢。
        -->
        <dependency>
            <groupId>com.rag</groupId>
            <artifactId>common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <!-- ============== 2. Spring Boot 基础（gRPC server 无 web） ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!--
            spring-boot-web-server：spring-cloud-starter-alibaba-nacos-discovery 通过反射引用
            org.springframework.boot.web.server.context.WebServerInitializedEvent。
            本模块不引 spring-boot-starter-web，但需要 spring-boot-web-server 里的那个类 + 抽象接口，
            与 message-rpc / like-rpc 同款。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-web-server</artifactId>
        </dependency>

        <!-- ============== 3. gRPC server ============== -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-core</artifactId>
        </dependency>
        <!-- @GrpcService 自动起 gRPC server（替代 zrpc.MustNewServer） -->
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-server-spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--
            ⚠️ 刻意不引 grpc-client-spring-boot-starter：
               Go 侧 task/rpc 的 ServiceContext 里 PointsClient / UserClient **整段被注释掉**了
               （service_context.go:18-19, 31-32, 55-56），reward Worker 也因此没被启动
               （initReward.go 整个文件是注释、task.go:35 的 StartInitReward 调用被注释）。
               ⇒ 本模块**零下游 gRPC 调用**，引 client starter 只会多一条永远不用的通道。
        -->

        <!-- ============== 4. Kafka（Go go-queue/kq + lovoo/goka） ============== -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!--
            ⚠️ spring-boot-kafka **不可省**：Spring Boot 4 把 Kafka 自动配置整体搬出了
            spring-boot-autoconfigure，改由独立模块提供（KafkaAutoConfiguration /
            ConcurrentKafkaListenerContainerFactoryConfigurer 都在这里）。
            只引 spring-kafka ⇒ 没有 ConsumerFactory Bean、没有 KafkaTemplate、
            @KafkaListener 后置处理器也不装配 ⇒ 表现为
            「NoSuchBeanDefinitionException: KafkaTemplate」，**组件直接起不来**。
            like-rpc 与 hot-rpc 都实测踩过（AGENTS.md §3.3），本模块照单继承。
            版本由 spring-boot-dependencies BOM 管理，不写 version。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-kafka</artifactId>
        </dependency>

        <!-- ============== 5. Redis（Go github.com/redis/go-redis/v9） ============== -->
        <!--
            Go task/rpc 用 Redis 做四件事，Spring Data Redis 全部覆盖：
              1. HGETALL/HSET/HDEL 任务进度缓存（GetTask 读 + 两个 sink 失效）
              2. SETNX 幂等标记（task:init:* / task:done:*）
              3. XADD 奖励事件流（stream:task:reward）
              4. 多 key pipeline 批量写（SET / HSET）
            ⇒ 用 StringRedisTemplate（Go 侧同样是裸字符串协议，key/value 都是 string）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
            ⚠️ commons-pool2 **不可省**（2026-10-27 G2 · Redis 连接池维度对齐）：
               本模块的 application.yml 配了
               `spring.data.redis.lettuce.pool.enabled: true`
               ⇒ Boot 4 的 `DataRedisConnectionConfiguration#isPoolEnabled`（`:195-198`）判据是
                  `Boolean enabled = pool.getEnabled(); return (enabled != null) ? enabled : COMMONS_POOL2_AVAILABLE;`
               ⇒ 显式配了 true 就走 `LettuceConnectionConfiguration#createBuilder:162-165` 的 `PoolBuilderFactory`
               ⇒ **该分支会构造 `org.apache.commons.pool2.impl.GenericObjectPoolConfig`**
                  （`LettuceConnectionConfiguration:32` 的 import + `:267-271` `getPoolConfig`）
               ⇒ 而 **Boot 4 的 starter 不再传递 commons-pool2** ⇒ 缺它 ⇒ **启动期直接失败**。
               ⚠️ 实测（本轮 · 2026-10-27）：`spring-boot-starter-data-redis:4.0.8` 的 pom 里
                  只有 `spring-boot-starter` + `spring-boot-data-redis` 两个依赖，
                  `spring-boot-data-redis:4.0.8` 的 pom 里也**没有** commons-pool2（只有 `lettuce-core`）
                  ⇒ ⇒ commons-pool2 **只能由应用自己声明**，无任何传递来源。
               ⚠️ 同款事故已有本仓实证：like-rpc 2026-10-23 缺它时启动报
                  `NoClassDefFoundError: org/apache/commons/pool2/impl/GenericObjectPoolConfig`。
               ⇒ Go 出处（形态对齐的依据）：真源 `service/task/rpc/internal/svc/service_context.go:25-29`
                  `redis.NewClient(&redis.Options{Addr, Password, DB})` ⇒ 只设 3 个字段
                  ⇒ `PoolSize` 未设 ⇒ 落 go-redis v9.20.0 库默认
                     （`go-redis@v9.20.0/options.go:350-351` `PoolSize = 10 * runtime.GOMAXPROCS(0)`）⇒ **Go 侧是有池的**
                  ⇒ RAG 侧若无池 ⇒ Lettuce 走**共享单连接** ⇒ 并发下命令互相串行排队
                  ⇒ **形态漂移**（不是数值漂移）⇒ 池大小按数量级对齐（Go 是 10×核数，机器相关 ⇒ 无法逐值对齐）。
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- ============== 6. 数据访问：Postgres + MyBatis-Plus + Flyway ============== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
            ⚠️ spring-boot-flyway 必需（Boot 4 拆模块，同 message-rpc DRIFT-MSG-006）。
            缺它时**启动日志里连一行 Flyway 都没有**（不是报错，是根本没加载），
            task_progress / user_like_count 永不创建，第一次真正查库才炸
            `relation "task_progress" does not exist`。TaskSchemaGate 是它的第二道防线。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- ============== 7. Metrics ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- ============== 8. OpenTelemetry OTLP exporter（Go Telemetry.*） ============== -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- ============== 9. Nacos 服务发现（替代 Go etcd 注册） ============== -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- ============== 10. 测试 ============== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            ⚠️ **scope 必须是 compile（默认），不能是 test**（2026-10-26 真启动实测修正）。
            根因是 Maven 的「最近者优先」：
              1) net.devh:grpc-server-spring-boot-starter:3.1.0.RELEASE **自身就传递依赖**
                 io.grpc:grpc-inprocess（compile scope）—— 实测 `mvn dependency:tree`：
                 `net.devh:grpc-server-spring-boot-starter:3.1.0.RELEASE:compile`
                 → `io.grpc:grpc-inprocess:jar:1.63.0:compile`；
              2) 本模块**又**显式声明了 grpc-inprocess —— 直接声明永远压过传递声明，
                 于是 scope 一旦写成 test，**运行时 classpath 上 grpc-inprocess 就整个消失**；
              3) devh 的 `GrpcServerFactoryAutoConfiguration` 里
                 `net/devh/boot/grpc/server/serverfactory/InProcessGrpcServerFactory`
                 的类签名硬引用 `io.grpc.inprocess.InProcessServerBuilder`
                 （实测 javap：该类 4 处引用 io/grpc/inprocess）⇒ 运行期链接失败
                 ⇒ `NoClassDefFoundError: io/grpc/inprocess/InProcessServerBuilder`
                 ⇒ **整个服务起不来**（硬失败，不是静默失效）。

            ⚠️ **为什么测试全绿却没发现**：测试跑在 test classpath 上，grpc-inprocess 本来就在，
            ⇒ **生产 classpath 从没被任何测试跑过**。
            这正是 AGENTS.md §3.3 的「跑绿 ≠ 对」。
            ⚠️ 同款 scope 缺陷（已修）：article-rpc / like-rpc（L12 lane）·
            follow-rpc（2026-10-24 已修，是本条的样板）。
            ⚠️ favorite-rpc 是同款缺陷但属 **favorite 禁区** ⇒ 本 lane 不碰。

            ⚠️ **必须显式写版本**：根 pom 的 dependencyManagement 只管 grpc-stub / -core /
            -netty-shaded / -protobuf / -protobuf-lite，**没有**管 grpc-inprocess，
            漏写版本会让整个 reactor 在读 POM 阶段就失败。与 follow-rpc / message-rpc 保持一致。
        -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <!--
            Testcontainers：装配层测试必须接**真 PostgreSQL**，不能用 H2。
            原因与 message-rpc / like-rpc 同款：
              - 本模块的 ON CONFLICT (user_id, task_id) / GREATEST / COALESCE 语义
                （两个 sink 的幂等核心）在 H2 上与 PG 不同，替换等于把要验证的东西换没了；
              - Flyway 的两份迁移脚本面向 PG 写的；
              - 有 @MapperScan 的模块没有 DataSource 就产不出 SqlSessionFactory
                ⇒ 「不接库」会让本测试要验证的东西根本没法验证。
        -->
        <!--
            ⚠️ artifactId 用的是 **Testcontainers 2.x** 的写法（testcontainers-postgresql /
               testcontainers-junit-jupiter），与 like-rpc / message-rpc 一致。
               此前这里写的是 1.x 的 `postgresql` / `junit-jupiter` —— 那两个 artifactId
               不在 spring-boot-dependencies 的 testcontainers-bom 里 ⇒ 版本无人管理 ⇒
               **Maven 连 pom 都读不进去**，报错
               "'dependencies.dependency.version' for org.testcontainers:postgresql:jar is missing"，
               于是整个 service/task 聚合模块（**含 task-api**）都无法构建。
               改名的另一个理由：1.x 的 `org.testcontainers:junit-jupiter` 早已被
               `testcontainers-junit-jupiter` 取代，前者是 testcontainers-shaded 的遗留坐标。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
            ⚠️ 集成测试必须关掉 Ryuk，否则 TaskProgressUpsertParityTest 的 15 条用例
            **静默全跳**（不是失败，是 skip，reactor 照报 BUILD SUCCESS）。

            原因链（每一环都实测过，见 docs/DRIFT/task/rpc.md 的 DRIFT-TASK-RPC-PITFALL-01）：
              1. 本类加了 @EnabledIfDockerAvailable ⇒ 判定发生在**类级**、早于任何测试方法；
              2. 该注解内部走 DockerAvailableDetector → DockerClientFactory.instance().client()，
                 而 client() 会顺带确保 **Ryuk 资源回收容器**可用；
              3. 本机拉不到 testcontainers/ryuk:0.14.0 ⇒ 抛 ContainerFetchException；
              4. DockerAvailableDetector 的实现是 `catch (Throwable) { return false; }`
                 ⇒ 「基础设施拉镜像失败」与「Docker 真不可用」被压成同一个 false；
              5. 整类被判 disabled ⇒ 15 条一条不跑。

            本模块此前是**全仓唯一漏配这一项**的容器模块
            （article/comment/favorite/follow/like/message + users 各 rpc/api 都配了）。
            注：Testcontainers 2.x 的 ResourceReaper 只读环境变量，
            `testcontainers.properties` 与 -D 系统属性均无效 —— 与 message-rpc 同款，不要换写法。
        -->
        <plugins>
            <!--
                🔴 **必须声明 spring-boot-maven-plugin**（2026-10-26 实测）。

                缺陷形态（与 message-api 的 DRIFT-MSG-V-028 同款，但本模块从未被发现）：
                  本模块此前**只有** maven-surefire-plugin 段 ⇒ 没有 repackage goal
                  ⇒ 打出来的是**普通 library jar**
                     （实测 83,827 B —— 对比 message-rpc 的 69,793,492 B fat jar）
                  ⇒ `java -jar task-rpc.jar` 直接报：
                     "no main manifest attribute, in task-rpc-0.0.1-SNAPSHOT.jar"
                     （中文环境：「中没有主清单属性」）
                  ⇒ **该模块从来没有被打成过可部署产物**。

                ⚠️ **不写 <mainClass>** —— 与 message-rpc / hot-rpc 保持一致，
                  让插件自动探测 `com.rag.task.task.rpc.TaskRpcApplication`
                  （service/task/task-rpc/src/main/java/com/rag/task/task/rpc/TaskRpcApplication.java:1）。
                ⚠️ 版本**不写**：由 spring-boot-starter-parent 的 pluginManagement 管（4.0.8）。
                ⚠️ **不要给 service/common 加这个 plugin** —— 它是 library 模块，
                  给它 repackage 会污染下游依赖（下游会拿到 fat jar）。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                ⚠️ 集成测试必须关掉 Ryuk，否则 TaskProgressUpsertParityTest 的 15 条用例
                **静默全跳**（不是失败，是 skip，reactor 照报 BUILD SUCCESS）。

                原因链（每一环都实测过，见 docs/DRIFT/task/rpc.md 的 DRIFT-TASK-RPC-PITFALL-01）：
                  1. 本类加了 @EnabledIfDockerAvailable ⇒ 判定发生在**类级**、早于任何测试方法；
                  2. 该注解内部走 DockerAvailableDetector → DockerClientFactory.instance().client()，
                     而 client() 会顺带确保 **Ryuk 资源回收容器**可用；
                  3. 本机拉不到 testcontainers/ryuk:0.14.0 ⇒ 抛 ContainerFetchException；
                  4. DockerAvailableDetector 的实现是 `catch (Throwable) { return false; }`
                     ⇒ 「基础设施拉镜像失败」与「Docker 真不可用」被压成同一个 false；
                  5. 整类被判 disabled ⇒ 15 条一条不跑。

                本模块此前是**全仓唯一漏配这一项**的容器模块
                （article/comment/favorite/follow/like/message + users 各 rpc/api 都配了）。
                注：Testcontainers 2.x 的 ResourceReaper 只读环境变量，
                `testcontainers.properties` 与 -D 系统属性均无效 —— 与 message-rpc 同款，不要换写法。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
                    </environmentVariables>
                </configuration>
                <executions>
                    <!--
                        🔴🔴 **2026-10-28：原来的「artifact-gate」execution 已撤除**（留痕）

                        原形态（2026-10-26）：surefire 的默认执行绑在 {@code test} 阶段，
                        而 fat jar 是 {@code package} 阶段（maven-jar-plugin:jar +
                        spring-boot:repackage）才生成的 ⇒ {@code test} 阶段 jar **还不存在**
                        ⇒ ⇒ 于是把产物层守门单独命名成 {@code *IT}，由这里**第二个 surefire
                        execution**（绑在 {@code verify} 阶段，{@code <include>**/*IT.java</include>}）
                        挑出来跑 ⇒ 产物必然是本次构建刚打出来的。

                        撤除理由：{@code *IT} **不**匹配 surefire 的默认 include
                        （{@code **/Test*.java} / {@code **/*Test.java} / …）
                        ⇒ ⇒ **收口回归（{@code mvn clean test}）跑不到它**
                        ⇒ ⇒ 本域的产物层守门在**收口口径里是缺失的**
                        （实测：task-rpc 的 {@code clean test} 条数不含那 5 条
                        ⇒ ⇒ 「产物层已被验证」这句话在收口口径下**不成立**）。

                        改法（照 like-rpc 的**已验证**形状）：{@code TaskRpcFatJarArtifactGateIT}
                        ⇒ 改名为 {@code TaskRpcFatJarArtifactGateTest}（回默认执行 ⇒ 进收口口径）
                        ⇒ 且把「test 阶段没有 jar」这个前提**消掉** —— 由**测试自己构建** fat jar
                        （构建命令带 {@code -am}）⇒ ⇒ 断言的产物是**当轮源码**打出来的
                        ⇒ ⇒ 既进了收口口径，又比原形状**更严**。

                        ⚠️ 若将来在本模块新增别的 {@code *IT} 类，**必须把下面这个 execution 加回来**
                        （否则那些类不会在任何阶段被跑到）：
                        <execution>
                            <id>artifact-gate</id>
                            <phase>verify</phase>
                            <goals><goal>test</goal></goals>
                            <configuration><includes><include>**/*IT.java</include></includes></configuration>
                        </execution>
                    -->
                </executions>
            </plugin>
        </plugins>
    </build>
</project>