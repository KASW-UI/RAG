# ============================================================================
# Sea-RideTheWind_java —— 环境变量样例
# ============================================================================
#
# 用法：
#   cp .env.example .env     # 然后把标了「必填」的行改成真值
#   ./manage.sh up            # 启动 users 域栈（root docker-compose.yaml）
#
# 🔴 **「必填」= 缺了就起不来**，这是设计意图，不是麻烦：
#   · 密钥类变量缺值 ⇒ 容器**拒绝渲染**（compose `:?`）或 Spring **绑定期直接炸**
#     ⇒ ⇒ **不存在「悄悄用空密钥 / 公开默认值起来」这条路径**（P0 #8 / X-11）。
#   · ⚠️ 「有默认值」≠「安全」：带默认值的密钥变量仍**建议覆盖**（默认值在仓里是公开的）。
#
# ⚠️ **为什么本文件用 `<...>` 占位而不是真值**：
#   密钥真值**不进版本控制**（生产密钥守门 `tools/difftest/check-no-prod-secrets.py`
#   会按 SHA-256 扫全仓）。本文件是**样例** ⇒ 只给结构与说明。
#
# ⚠️ **Docker Compose 与 Spring 的占位符语法不同，千万别混**：
#   · Compose：`${VAR:?message}` = 缺变量 ⇒ **报错退出**（本文件要的就是这个）
#   · Spring ：`${VAR:?message}` = 缺变量 ⇒ **取字面量 "?message"**（用它反而更危险）
#   ⇒ 本仓的 Spring 侧一律用 `${VAR}`（无默认值 ⇒ 绑定期炸）+ `@PostConstruct` 兜空串。
# ============================================================================


# ============================================================================
# 1. 必填 · 密钥（**无默认值 ⇒ 缺了就起不来**）
# ============================================================================

# 🔴 用户域 JWT 签名密钥 —— **user-api / user-rpc 是签发方**，
#    而 article-api / comment-api / follow-api / like-api / message-api
#    **只验签、不签发** ⇒ 它们的验签密钥必须与本值**完全一致**，
#    否则验签必失败（表现为 **HTTP 401 + 空 body**，不是业务码）。
# · **≥ 32 字节**（jjwt 的 HMAC-SHA256 下限；不足会被 JwtUtil.padToHmacKeySize 补齐）
# · **必须与签发方一致** ⇒ 改这一处要同时改所有验签方
# · 建议：`openssl rand -hex 32`
USER_JWT_SECRET=<openssl rand -hex 32>

# 🔴 管理域 JWT 签名密钥 —— admin-api / admin-rpc 专用，与用户域**分开**。
ADMIN_JWT_SECRET=<openssl rand -hex 16>

# 🔴 favorite 域的验签密钥 —— favorite-api 用（只验签，签发方仍是 user-api）。
#    ⚠️ 设为空串 ⇒ favorite-api **启动失败**（不是「验签永远失败」）。
FAVORITE_JWT_SECRET=<与 USER_JWT_SECRET 相同的值>

# 🔴 Postgres 密码 —— root docker-compose.yaml 用 `${POSTGRES_PASSWORD:?...}`
#    ⇒ 缺值 ⇒ compose **拒绝渲染**（不是「起个空密码的库」）。
POSTGRES_PASSWORD=<自定，勿用默认>


# ============================================================================
# 2. 建议覆盖 · 部署凭据（**有默认值，但仓里是公开的 ⇒ 生产必须覆盖**）
# ============================================================================

# 🔴 MinIO（对象存储）访问凭据 —— article-rpc 用（上传/下载图片）。
#    ⚠️ 默认值 `minioadmin` 是 MinIO 官方公开默认值 ⇒ 谁都能连上你的桶。
MINIO_ACCESS_KEY=<自定>
MINIO_SECRET_KEY=<自定>

# 🔴 事实权威端（fact-authority）的内部调用令牌 —— like-rpc / comment-rpc /
#    favorite-rpc 用。默认空串 ⇒ **不校验调用方身份** ⇒ 生产必须覆盖。
LIKE_FACT_AUTHORITY_TOKEN=<自定>
COMMENT_FACT_AUTHORITY_TOKEN=<自定>
FAVORITE_AUTHORITY_TOKEN=<自定>

# 🔴 外部平台（DC platform）事件回调的共享令牌 —— like-rpc / comment-rpc /
#    favorite-rpc 用。默认空串 ⇒ 事件回调**不验签** ⇒ 生产必须覆盖。
DC_PLATFORM_SERVICE_TOKEN=<自定>
DC_PLATFORM_EVENT_URL=<事件回调地址，默认空 = 不启用>

# 🔴 admin 初始账号密码 —— admin-rpc 建管理员时用。默认 `123456` ⇒ 生产必须覆盖。
ADMIN_DEFAULT_PASSWORD=<自定，勿用 123456>

# Redis 密码 —— 默认空 = 无认证（本地开发友好）。生产建议开。
REDIS_PASSWORD=

# Nacos 账号密码 —— 默认空 = standalone 无认证。生产建议开。
NACOS_USERNAME=
NACOS_PASSWORD=


# ============================================================================
# 3. 基础设施连接（**默认值适合本地 compose**；换环境时改这里）
# ============================================================================

# ---- Postgres ----
POSTGRES_USER=admin
POSTGRES_DB=first_db
POSTGRES_HOST=postgres          # 容器内 DNS 名（compose 内）；宿主机跑用 127.0.0.1
POSTGRES_ADDR=postgres          # compose 用的那个（容器内 DNS）
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# ---- Redis ----
REDIS_ADDR=redis
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Nacos（服务发现 / 配置中心）----
NACOS_ADDR=nacos
NACOS_PORT=8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP

# ---- Kafka（hot / like / task / comment / favorite 的事件总线）----
KAFKA_BROKERS=kafka:9092

# ---- MinIO（对象存储）----
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_BASE_URL=http://localhost:39000

# ---- OpenTelemetry / Jaeger ----
OTEL_ADDR=jaeger
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317
OTLP_PORT=4317


# ============================================================================
# 4. 端口（**默认 = 各域在 compose 里预留的号段**）
# ============================================================================

# ---- users 域（root docker-compose.yaml 实际编排的就是这两个）----
USER_API_PORT=49900
USER_RPC_PORT=49210
ADMIN_API_PORT=8889
ADMIN_RPC_PORT=8081

# ---- 其余 8 个域（**root compose 未编排** ⇒ 见 README「怎么起其余 9 个域」）----
ARTICLE_API_PORT=8889
COMMENT_API_PORT=8888
COMMENT_RPC_TARGET=127.0.0.1:9001
FAVORITE_API_PORT=18893
FOLLOW_API_PORT=8891
FOLLOW_RPC_PORT=8082
HOT_API_PORT=18897
HOT_RPC_GRPC_PORT=8083
MESSAGE_API_PORT=8892
TASK_API_PORT=18886
TASK_RPC_ADDRESS=127.0.0.1:9005

# ---- JWT 有效期（秒）----
USER_JWT_EXPIRE=31536000         # 365 天
ADMIN_JWT_EXPIRE=2592000         # 30 天
FAVORITE_JWT_EXPIRE=2592000      # 30 天

# ---- 服务发现命名 ----
COMMENT_RPC_ADDRESS=discovery:///comment-rpc

# ---- 编排（root docker-compose.yaml）----
CONTAINER_PREFIX=Sea
DOCKER_NETWORK=Sea-TryGo
SNOWFLAKE_NODE_ID=1
